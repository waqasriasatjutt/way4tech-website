# Cloudflare Pages redirects.
# Path based only: apex vs www canonicalisation is NOT expressible here and
# has to be a Redirect Rule in the Cloudflare dashboard.
/blog/odoo-community-vs-enterprise-2026/  /blog/odoo-community-vs-enterprise-decided-properly/  301

# /about-us/ was the old URL. It 404s today but is still in Google's index and
# still ranks for the brand, showing a "site will be available soon" snippet.
/about-us/  /about/  301
/about-us   /about/  301

# robots.txt names /sitemap-index.xml and Google follows that, but crawlers and
# audit tools probe the conventional path first and were getting the 404 page.
/sitemap.xml  /sitemap-index.xml  301

# WordPress-era URLs. These are still in search indexes and still attract links,
# and every one of them was answering with the 404 page, so the equity was being
# thrown away. Each target is the page that now answers the same intent.
/implementation/     /services/odoo-implementation/  301
/implementation      /services/odoo-implementation/  301
/customization/      /services/odoo-customization/   301
/customization       /services/odoo-customization/   301
/support/            /services/odoo-support/         301
/support             /services/odoo-support/         301
/training/           /services/odoo-training/        301
/training            /services/odoo-training/        301
/migration/          /services/odoo-migration/       301
/migration           /services/odoo-migration/       301
/integration/        /services/odoo-integration/     301
/integration         /services/odoo-integration/     301
/company/            /about/                         301
/company             /about/                         301
/services/odoo-erp/  /services/                      301
/odoo-development/   /services/odoo-customization/   301
/odoo-erp/           /services/                      301
/hire-odoo-developer/ /services/hire-odoo-developer/ 301

# The old WordPress blog published under /YYYY/MM/DD/<slug>/. The posts were not
# migrated, so the honest destination is the blog index rather than an unrelated
# post. Splat keeps a single rule instead of one per dated URL.
/2024/*  /blog/  301
/2025/*  /blog/  301

# Common probes that were returning the 404 page.
/feed/       /blog/  301
/rss/        /blog/  301
/blog/feed/  /blog/  301
