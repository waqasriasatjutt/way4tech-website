---
/* A short boxed note inside a guide: a limitation, a check before go-live. */
export interface Props {
  title?: string;
}
const { title } = Astro.props;
---
<aside class="not-prose my-8 rounded-xl border border-brand-200 bg-brand-50 p-5 text-ink-800">
  {title && <p class="font-semibold text-ink-900">{title}</p>}
  <div class="mt-1 space-y-2 text-[0.95rem] leading-relaxed"><slot /></div>
</aside>
