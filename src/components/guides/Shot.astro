---
/*
 * A real screenshot in a guide. Every image is copied from the module's own
 * static/description folder and converted to WebP; width and height are the
 * file's real pixel size so the browser reserves the space before it loads.
 */
export interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  caption?: string;
}
const { src, alt, width, height, caption } = Astro.props;
---
<figure class="not-prose my-8">
  <a href={src} class="block overflow-hidden rounded-xl border border-ink-200 bg-ink-50" target="_blank" rel="noopener">
    <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" class="h-auto w-full" />
  </a>
  {caption && <figcaption class="mt-2 text-sm text-ink-500">{caption}</figcaption>}
</figure>
