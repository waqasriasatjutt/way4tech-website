---
/* Screenshot grid for product and suite pages. Desktop shots stack full width,
   phone shots sit three across. */
interface Shot { src: string; alt: string; caption?: string; w: number; h: number; phone?: boolean }
const { shots = [] } = Astro.props as { shots: Shot[] };
const desk = shots.filter(s => !s.phone);
const phones = shots.filter(s => s.phone);
---
{desk.length > 0 && (
  <div class="space-y-10">
    {desk.map(s => (
      <figure>
        <img src={s.src} alt={s.alt} width={s.w} height={s.h} loading="lazy" decoding="async"
             class="h-auto w-full rounded-2xl border border-ink-200 shadow-sm" />
        {s.caption && <figcaption class="mt-3 text-sm text-ink-600">{s.caption}</figcaption>}
      </figure>
    ))}
  </div>
)}
{phones.length > 0 && (
  <div class="mt-10 grid gap-6 grid-cols-2 sm:grid-cols-3">
    {phones.map(s => (
      <figure>
        <img src={s.src} alt={s.alt} width={s.w} height={s.h} loading="lazy" decoding="async"
             class="mx-auto h-auto w-full max-w-[260px] rounded-3xl border border-ink-200 shadow-sm" />
        {s.caption && <figcaption class="mt-3 text-center text-sm text-ink-600">{s.caption}</figcaption>}
      </figure>
    ))}
  </div>
)}
