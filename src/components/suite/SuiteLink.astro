---
/* "Our X suite" block for solution, industry and module pages. */
interface Props { link?: { href: string; name: string } }
const { link } = Astro.props;
---
{link && (
  <div class="mt-6 rounded-2xl border border-brand-200 bg-brand-50 p-5">
    <p class="text-ink-800"><strong>Our {link.name} suite:</strong> the store modules we publish for this, with prices, a live demo where there is one and free guides.</p>
    <a href={link.href} class="mt-3 inline-block font-semibold text-brand-700 hover:text-brand-800">See the {link.name} suite &rarr;</a>
  </div>
)}
