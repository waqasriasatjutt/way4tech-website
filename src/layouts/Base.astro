---
import { SITE } from '~/data/site';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import { portalOverride } from '~/lib/portal';
import '~/styles/global.css';

export interface HreflangAlternate {
  lang: string;
  href: string;
}

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  structuredData?: object | object[];
  noindex?: boolean;
  hreflang?: HreflangAlternate[];
  /** og:type. Articles get "article" plus their dates; everything else is a page. */
  ogType?: 'website' | 'article';
  publishedTime?: string | Date;
  modifiedTime?: string | Date;
}

const {
  title,
  description = SITE.description,
  image = '/og.png',
  canonical,
  structuredData,
  noindex = false,
  hreflang,
  ogType = 'website',
  publishedTime,
  modifiedTime,
} = Astro.props;

// Every page declared og:type="website", so a shared blog post was never
// treated as an article by anything reading Open Graph.
const iso = (v?: string | Date) =>
  v ? (v instanceof Date ? v.toISOString() : new Date(v).toISOString()) : undefined;
const publishedISO = iso(publishedTime);
const modifiedISO = iso(modifiedTime) || publishedISO;

// Content authored in Odoo for this path wins. Absent or unreachable: static stands.
const ov = await portalOverride(Astro.url.pathname);
const effTitle = ov?.metaTitle || ov?.title || title;
const effDescription = ov?.description || description;
const effCanonical = ov?.canonical || canonical;
const effNoindex = ov?.noindex === true ? true : noindex;

const pageTitle = effTitle ? `${effTitle} | ${SITE.name}` : `${SITE.name} - ${SITE.tagline}`;
const canonicalURL = effCanonical || new URL(Astro.url.pathname, SITE.url).toString();
const imageURL = new URL(image, SITE.url).toString();
const imageAlt = effTitle ? `${effTitle} - ${SITE.name}` : `${SITE.name} - Odoo Partner`;
const robots = effNoindex ? 'noindex,follow' : 'index,follow';
const alternates = Array.isArray(hreflang) ? hreflang : [];

// twitter:site is only emitted if a handle actually exists in SITE.social.
const social = SITE.social as Record<string, string | undefined>;
const twitterHandleRaw = social.twitter || social.x || '';
const twitterHandle = twitterHandleRaw ? (twitterHandleRaw.startsWith('@') ? twitterHandleRaw : `@${twitterHandleRaw}`) : '';

const fontHref = 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap';

// Stable node identities. Giving the Organization an @id lets the WebSite node
// point at it instead of repeating the whole company block.
const orgId = new URL('/#organization', SITE.url).toString();
const webSiteId = new URL('/#website', SITE.url).toString();

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': orgId,
  name: SITE.name,
  legalName: 'Way4Tech',
  url: SITE.url,
  logo: new URL('/logo-w4t.png', SITE.url).toString(),
  image: {
    '@type': 'ImageObject',
    url: new URL('/og.png', SITE.url).toString(),
    width: 1200,
    height: 630,
  },
  description: SITE.description,
  foundingDate: '2016',
  slogan: 'Odoo ERP implementation, customization, hosting, and support.',
  areaServed: SITE.locations,
  contactPoint: [{
    '@type': 'ContactPoint',
    email: SITE.email,
    telephone: SITE.phone,
    contactType: 'sales',
    availableLanguage: ['English', 'Arabic', 'Urdu'],
  }],
  sameAs: [SITE.social.linkedin, SITE.social.github],
};

// The WebSite node belongs to the site as a whole, so it is emitted once, on the
// homepage, and nowhere else. trailingSlash is 'always', so the built homepage
// path is '/'; the '/index.html' form is accepted for a direct file hit.
// No SearchAction: there is no internal search endpoint to point one at.
const homePath = Astro.url.pathname;
const isHome = homePath === '/' || homePath === '/index.html';

const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': webSiteId,
  name: SITE.name,
  url: new URL('/', SITE.url).toString(),
  inLanguage: 'en',
  publisher: { '@id': orgId },
};

const ovSchema = (() => {
  const raw = ov?.schema;
  if (!raw) return [];
  try { const v = typeof raw === 'string' ? JSON.parse(raw) : raw; return Array.isArray(v) ? v : [v]; }
  catch { return []; }
})();
const sdArray = [orgSchema, ...(isHome ? [webSiteSchema] : []), ...(Array.isArray(structuredData) ? structuredData : structuredData ? [structuredData] : []), ...ovSchema];
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#714B67" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <title>{pageTitle}</title>
    <meta name="description" content={effDescription} />
    <meta name="robots" content={robots} />

    {alternates.length > 0 && (
      <>
        {alternates.map((alt) => (
          <link rel="alternate" hreflang={alt.lang} href={alt.href} />
        ))}
        <link rel="alternate" hreflang="x-default" href={canonicalURL} />
      </>
    )}

    <meta property="og:type" content={ogType} />
    {ogType === 'article' && publishedISO && (
      <meta property="article:published_time" content={publishedISO} />
    )}
    {ogType === 'article' && modifiedISO && (
      <meta property="article:modified_time" content={modifiedISO} />
    )}
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={ov?.ogTitle || pageTitle} />
    <meta property="og:description" content={ov?.ogDescription || effDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    {twitterHandle && <meta name="twitter:site" content={twitterHandle} />}
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={effDescription} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href={fontHref} onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href={fontHref} /></noscript>

    {ov?.cssBody && <style set:html={ov.cssBody} />}

    {sdArray.map((sd) => (
      <script type="application/ld+json" set:html={JSON.stringify(sd)} />
    ))}
  </head>
  <body class="min-h-screen bg-white text-ink-900 antialiased">
    <Header />
    <main>
      <slot />
      {ov?.htmlBody && (
        <section class="section">
          <div class="container-site">
            <div class="prose prose-ink max-w-none" set:html={ov.htmlBody} />
          </div>
        </section>
      )}
    </main>
    <Footer />
    <script is:inline>
    /*
      Motion, added only once JS is running so the no-JS state stays visible.
      IntersectionObserver rather than a scroll listener, per the brief: a
      scroll handler on 598 pages would fire hundreds of times a second and
      cost exactly the INP the rest of this work is protecting.
    */
    (function () {
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
      if (reduce.matches) return;
      document.documentElement.classList.add('js-motion');

      var targets = document.querySelectorAll('[data-reveal], [data-reveal-group]');
      if (!targets.length || !('IntersectionObserver' in window)) {
        targets.forEach(function (el) { el.classList.add('is-visible'); });
        return;
      }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);   // one shot: nothing re-animates on scroll back
        });
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
      targets.forEach(function (el) { io.observe(el); });

      /* Count-up for anything marked data-count, driven by the same observer
         pattern so numbers animate when they are actually on screen. */
      var nums = document.querySelectorAll('[data-count]');
      if (nums.length && 'IntersectionObserver' in window) {
        var nio = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            var el = entry.target;
            nio.unobserve(el);
            var target = parseFloat(el.getAttribute('data-count'));
            if (isNaN(target)) return;
            var suffix = el.getAttribute('data-count-suffix') || '';
            var start = performance.now();
            var dur = 900;
            (function step(now) {
              var t = Math.min(1, (now - start) / dur);
              var eased = 1 - Math.pow(1 - t, 3);
              el.textContent = Math.round(target * eased).toLocaleString() + suffix;
              if (t < 1) requestAnimationFrame(step);
            })(start);
          });
        }, { threshold: 0.4 });
        nums.forEach(function (el) { nio.observe(el); });
      }
    })();
  </script>
</body>
</html>
