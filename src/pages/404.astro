---
import Base from '~/layouts/Base.astro';
import { SITE, SERVICES, MODULES, SOLUTIONS, COUNTRIES, PRODUCTS, CASE_STUDIES } from '~/data/site';

const sections = [
  { href: '/services/',     title: 'Services',     desc: `${SERVICES.length} Odoo services, from first implementation through to long-term support.` },
  { href: '/solutions/',    title: 'Solutions',    desc: `${SOLUTIONS.length} ready-built solutions grouped by the problem they solve.` },
  { href: '/countries/',    title: 'Countries',    desc: `${COUNTRIES.length} countries with local language, currency, and compliance work.` },
  { href: '/modules/',      title: 'Modules',      desc: `${MODULES.length} Odoo apps we configure, extend, and maintain.` },
  { href: '/products/',     title: 'Products',     desc: `${PRODUCTS.length} modules and themes you can buy and install today.` },
  { href: '/case-studies/', title: 'Case studies', desc: `${CASE_STUDIES.length} projects with the scope, the constraints, and the result.` },
  { href: '/blog/',         title: 'Blog',         desc: 'Guides on Odoo versions, hosting, payroll, and upgrades.' },
  { href: '/contact/',      title: 'Contact',      desc: 'Tell us what you were looking for and we will point you at it.' },
];

const popularServices = SERVICES.slice(0, 8);
const popularCountries = COUNTRIES.slice(0, 8);
---
<Base
  title="Page not found (404)"
  description="That page does not exist on way4tech.com. Jump to Odoo services, solutions, country pages, modules, products, case studies, or get in touch."
  noindex={true}
>
  <section class="bg-ink-900 text-white">
    <div class="container-site py-16 sm:py-24">
      <div class="max-w-3xl">
        <div class="eyebrow text-brand-300">Error 404</div>
        <h1 class="h1 mt-4">Page not found.</h1>
        <p class="lede mt-6 text-ink-300">
          The address you followed does not match anything on this site. The page may have been renamed,
          or the link may be mistyped. Everything below is one click away.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/" class="btn-primary bg-white !text-brand-700 hover:bg-brand-50">Back to home</a>
          <a href="/contact/" class="btn-secondary !bg-white/5 !border-white/20 !text-white hover:!bg-white/10">Tell us what you needed</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-site">
      <h2 class="h3">Main sections</h2>
      <p class="mt-3 text-ink-600">Start from one of these instead.</p>
      <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {sections.map(s => (
          <a href={s.href} class="card group">
            <h3 class="text-lg font-semibold">{s.title}</h3>
            <p class="mt-2 text-sm text-ink-600">{s.desc}</p>
            <span class="mt-4 inline-block text-sm font-semibold text-brand-600 group-hover:text-brand-700">Open →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-ink-50 border-t border-ink-100">
    <div class="container-site">
      <div class="grid gap-12 lg:grid-cols-2">
        <div>
          <h2 class="h3">Most-requested services</h2>
          <div class="mt-6 flex flex-wrap gap-2">
            {popularServices.map(s => (
              <a href={`/services/${s.slug}/`} class="chip hover:bg-ink-200">{s.title}</a>
            ))}
          </div>
          <a href="/services/" class="mt-6 inline-block text-sm font-semibold text-brand-600 hover:text-brand-700">All services →</a>
        </div>
        <div>
          <h2 class="h3">Where we work</h2>
          <div class="mt-6 flex flex-wrap gap-2">
            {popularCountries.map(c => (
              <a href={`/countries/${c.slug}/`} class="chip hover:bg-ink-200">{c.flag} {c.title}</a>
            ))}
          </div>
          <a href="/countries/" class="mt-6 inline-block text-sm font-semibold text-brand-600 hover:text-brand-700">All countries →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section border-t border-ink-100">
    <div class="container-site">
      <div class="max-w-2xl">
        <h2 class="h3">Still stuck?</h2>
        <p class="mt-3 text-ink-700">
          If you arrived here from a link on another site, or from a bookmark that used to work,
          send us the address and we will fix the redirect.
        </p>
        <ul class="mt-6 space-y-2 text-sm">
          <li><a class="text-ink-700 hover:text-brand-600" href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li><a class="text-ink-700 hover:text-brand-600" href={SITE.whatsapp} rel="noopener">WhatsApp {SITE.phone}</a></li>
        </ul>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="btn-primary" href="/contact/">Contact us</a>
          <a class="btn-secondary" href="/resources/">Browse resources</a>
        </div>
      </div>
    </div>
  </section>
</Base>
