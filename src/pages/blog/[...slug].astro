---
import Base from '~/layouts/Base.astro';
import { SITE } from '~/data/site';
import { MODULE_CATALOG, type StoreModule } from '~/data/modules-catalog';
import { getCollection } from 'astro:content';
import { fetchOdooBlogPosts, type OdooBlogPost } from '~/lib/odoo';

export async function getStaticPaths() {
  const mdxPosts = await getCollection('blog');
  const odooPosts = await fetchOdooBlogPosts();

  const mdx = mdxPosts.map(p => ({
    params: { slug: p.slug },
    props: { kind: 'mdx' as const, post: p, odoo: null as OdooBlogPost | null },
  }));
  const odoo = odooPosts.map(p => ({
    params: { slug: p.slug },
    props: { kind: 'odoo' as const, post: null, odoo: p },
  }));
  return [...mdx, ...odoo];
}

const { kind, post, odoo } = Astro.props;

const title = kind === 'odoo' ? odoo!.title : post!.data.title;
const description = kind === 'odoo'
  ? (odoo!.teaser || odoo!.subtitle || odoo!.title)
  : post!.data.description;
const author = kind === 'odoo' ? odoo!.author : post!.data.author;
const date = kind === 'odoo' ? odoo!.postDate : post!.data.date;
const tags = kind === 'odoo' ? odoo!.tags : post!.data.tags;

const Content = kind === 'mdx' ? (await post!.render()).Content : null;

/*
 * Author identity.
 *
 * Posts under the site byline link to /author/waqas-riasat/, and their Person
 * node in the schema carries the @id and url of that page so the two are one
 * entity rather than a name repeated on thirteen pages. Posts written by anyone
 * else in the Odoo portal keep a plain name and no link, because there is no
 * author page standing behind them.
 *
 * These consts are read by the template only. getStaticPaths above is hoisted
 * out of this scope and cannot see them, which is exactly why nothing here is
 * referenced from inside it.
 */
const SITE_AUTHOR = 'Waqas Riasat';
const AUTHOR_PATH = '/author/waqas-riasat/';
const AUTHOR_URL = new URL(AUTHOR_PATH, SITE.url).toString();

const authorName = (typeof author === 'string' ? author.trim() : '') || SITE.name;
const isSiteAuthor = authorName.toLowerCase() === SITE_AUTHOR.toLowerCase();

/* The one line of author evidence worth carrying onto a post: modules actually
   listed on the store, counted from the catalogue on every build rather than
   written down. Same test /products/ and the author page use. */
const catalog: Record<string, StoreModule | undefined> = MODULE_CATALOG ?? {};
const publishedModuleCount = Object.values(catalog).filter(
  m => m?.published === true && typeof m.storeUrl === 'string' && m.storeUrl.trim().startsWith('https://apps.odoo.com/'),
).length;

const authorNode = isSiteAuthor
  ? { '@type': 'Person', '@id': `${AUTHOR_URL}#person`, name: authorName, url: AUTHOR_URL }
  : { '@type': 'Person', name: authorName };

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  author: authorNode,
  datePublished: date.toISOString(),
  dateModified: (kind === 'odoo' ? odoo!.writeDate : date).toISOString(),
  publisher: { '@type': 'Organization', name: SITE.name, logo: { '@type': 'ImageObject', url: `${SITE.url}/logo.svg` } },
};

/* Mirrors the breadcrumb printed in the hero. The template carried none before,
   so this adds a node rather than duplicating one. */
const slugParam = typeof Astro.params.slug === 'string' ? Astro.params.slug.trim() : '';
const postPath = slugParam ? `/blog/${slugParam}/` : '/blog/';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog/', SITE.url).toString() },
    { '@type': 'ListItem', position: 3, name: title, item: new URL(postPath, SITE.url).toString() },
  ],
};
---
<Base
  title={title}
  description={description}
  ogType="article"
  publishedTime={date}
  structuredData={[schema, breadcrumbSchema]}
>
  <section class="bg-odoo-gradient text-white">
    <div class="container-site py-14">
      <nav class="text-sm text-brand-200"><a href="/" class="hover:text-white">Home</a> / <a href="/blog/" class="hover:text-white">Blog</a></nav>
      <div class="mt-6 max-w-3xl">
        <div class="flex gap-2 flex-wrap">
          {tags.map(t => <span class="text-xs font-medium text-brand-100 bg-white/10 rounded-full px-2.5 py-0.5">{t}</span>)}
          {kind === 'odoo' && <span class="text-[10px] font-semibold uppercase tracking-wider text-accent-300 bg-white/5 rounded-full px-2.5 py-0.5">Live from Odoo</span>}
        </div>
        <h1 class="mt-5 text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight">{title}</h1>
        {kind === 'odoo' && odoo!.subtitle && (<p class="mt-3 text-lg text-brand-100">{odoo!.subtitle}</p>)}
        <p class="mt-4 text-brand-100">
          {isSiteAuthor ? (
            <a href={AUTHOR_PATH} rel="author" class="font-semibold text-white underline decoration-white/40 underline-offset-4 transition hover:decoration-white">{authorName}</a>
          ) : (
            <span>{authorName}</span>
          )}
          {' · '}
          <time datetime={date.toISOString()}>{date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</time>
        </p>
      </div>
    </div>
  </section>

  <article class="section">
    <div class="container-site max-w-3xl">
      <div class="prose prose-lg prose-ink max-w-none
                  prose-headings:tracking-tight prose-headings:text-ink-900
                  prose-a:text-brand-600 hover:prose-a:text-brand-700
                  prose-strong:text-ink-900
                  prose-code:text-brand-700 prose-code:bg-brand-50 prose-code:px-1 prose-code:py-0.5 prose-code:rounded
                  prose-code:before:content-none prose-code:after:content-none
                  prose-pre:bg-ink-950 prose-pre:text-ink-100
                  prose-img:rounded-xl">
        {kind === 'mdx' && Content && <Content />}
        {kind === 'odoo' && <Fragment set:html={odoo!.contentHtml} />}
      </div>

      {isSiteAuthor && (
        <div class="mt-16 rounded-2xl border border-ink-200 p-6 sm:p-8">
          <h2 class="text-xs font-semibold uppercase tracking-wider text-ink-500">Written by</h2>
          <p class="mt-2 text-xl font-semibold">
            <a href={AUTHOR_PATH} rel="author" class="hover:text-brand-700">{authorName}</a>
          </p>
          <p class="mt-3 text-ink-600">
            Odoo developer at {SITE.name}.
            {publishedModuleCount > 0
              ? ` ${publishedModuleCount} modules published on the Odoo apps store.`
              : ' Builds Odoo modules.'}
            {' '}Writes the Odoo posts on this site.
          </p>
          <a href={AUTHOR_PATH} class="mt-4 inline-block text-sm font-semibold text-brand-700 hover:text-brand-800">Profile and published work</a>
        </div>
      )}

      <div class="mt-16 rounded-2xl bg-ink-50 p-8 text-center">
        <h3 class="text-xl font-semibold">Have an Odoo project?</h3>
        <p class="mt-2 text-ink-600">Free 30-minute consultation, no obligation.</p>
        <a href={`/contact/?source=blog/${Astro.params.slug}`} class="btn-primary mt-6">Talk to us</a>
      </div>
    </div>
  </article>
</Base>
