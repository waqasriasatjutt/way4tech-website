---
import Base from '~/layouts/Base.astro';
import { breadcrumb } from '~/utils/schema';

const roles = [
  { title: 'Senior Odoo Developer (Python + OWL)', type: 'Full-time · Remote', desc: '5+ years Odoo. Deep Python, PostgreSQL, and OWL framework experience. You will own modules end-to-end.' },
  { title: 'Odoo Functional Consultant', type: 'Full-time · Remote', desc: '4+ years functional Odoo. Lead discovery, design workflows, run UAT, train users - across industries.' },
  { title: 'Odoo Project Manager', type: 'Full-time · Remote', desc: 'Run multi-country Odoo rollouts. Stakeholder communication, scope control, delivery discipline.' },
  { title: 'DevOps / SRE (Odoo)', type: 'Full-time · Remote', desc: 'Docker, PostgreSQL, Cloudflare, Nginx. Multi-tenant SaaS operations, backups, monitoring.' },
  { title: 'QA Engineer (Odoo)', type: 'Full-time · Remote', desc: 'Automated and manual QA for Odoo modules. pytest, tours, regression suites.' },
  { title: 'Business Development (GCC)', type: 'Full-time · Riyadh/Dubai', desc: 'Own pipeline in KSA, UAE, Qatar. Consultative sales, 5+ years in enterprise software.' },
];
---
<Base
  structuredData={breadcrumb([{ name: 'Careers', path: '/careers/' }])} title="Careers - Work with Way4Tech" description="Careers at Way4Tech. Remote-first, senior-only Odoo roles. Python, OWL, functional consulting, project management, DevOps, QA, BD.">
  <section class="bg-ink-900 text-white">
    <div class="container-site py-16 sm:py-24">
      <div class="max-w-3xl">
        <div class="eyebrow text-brand-300">Careers</div>
        <h1 class="h1 mt-4">Senior engineers. Real ownership. No BS.</h1>
        <p class="lede mt-6 text-ink-300">We hire experienced Odoo people and give them room to do their best work. Remote-first with meet-ups in Dubai and Karachi.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-site">
      <h2 class="h3">Open roles</h2>
      <div class="mt-8 space-y-4">
        {roles.map(r => (
          <div class="card flex flex-col sm:flex-row sm:items-center justify-between gap-5">
            <div>
              <h3 class="font-semibold text-lg">{r.title}</h3>
              <p class="mt-1 text-xs text-brand-600 font-semibold">{r.type}</p>
              <p class="mt-2 text-sm text-ink-600">{r.desc}</p>
            </div>
            <a href="/contact/" class="btn-primary shrink-0">Apply</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- HOW HIRING WORKS -->
  <section class="section bg-ink-50 border-y border-ink-100">
    <div class="container-site">
      <h2 class="h2">How hiring works here</h2>
      <p class="lede mt-4 max-w-3xl text-ink-700">
        Four steps, about two weeks end to end, and you hear back either way at every one of them.
      </p>
      <ol class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {[
          { n: '1', t: 'You send something real', d: 'A CV is fine. A module you wrote, a repository, or a problem you solved is better. We read the code before the CV.' },
          { n: '2', t: 'A technical conversation', d: 'About an hour, about work you have actually done. No whiteboard algorithms and no puzzles: the job is Odoo, so we talk about Odoo.' },
          { n: '3', t: 'A small paid exercise', d: 'A scoped task close to real work, paid at your rate. We do not ask anyone to work for free to be assessed.' },
          { n: '4', t: 'Offer, with the numbers', d: 'Salary, currency, payment date and what the review cycle is. In writing, before you are asked to decide.' },
        ].map(s => (
          <li class="card">
            <div class="text-sm font-bold text-brand-600">{s.n}</div>
            <h3 class="mt-2 text-base font-semibold">{s.t}</h3>
            <p class="mt-2 text-sm text-ink-600">{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- HOW WE WORK -->
  <section class="section">
    <div class="container-site">
      <h2 class="h2">How the work actually runs</h2>
      <div class="mt-10 grid gap-8 lg:grid-cols-2">
        <div>
          <h3 class="h3">What you get</h3>
          <ul class="mt-4 space-y-2 text-ink-700">
            <li class="flex gap-3"><span class="text-brand-600">&#10003;</span><span>Remote, with your own hours. Overlap for the calls that need it, not a webcam watching you type.</span></li>
            <li class="flex gap-3"><span class="text-brand-600">&#10003;</span><span>Modules you own end to end, published under the company name on the Odoo apps store with your work in them.</span></li>
            <li class="flex gap-3"><span class="text-brand-600">&#10003;</span><span>Direct contact with the client. Nobody relays requirements to you through three people.</span></li>
            <li class="flex gap-3"><span class="text-brand-600">&#10003;</span><span>Paid on the same date every month, in a currency agreed up front.</span></li>
            <li class="flex gap-3"><span class="text-brand-600">&#10003;</span><span>Meet-ups in Dubai and Karachi, and the tooling you ask for.</span></li>
          </ul>
        </div>
        <div>
          <h3 class="h3">What we do not do</h3>
          <ul class="mt-4 space-y-2 text-ink-700">
            <li class="flex gap-3"><span class="text-ink-400">&#10007;</span><span>Unpaid take-home tests, or a "trial month" at a reduced rate.</span></li>
            <li class="flex gap-3"><span class="text-ink-400">&#10007;</span><span>Timesheets used to work out what you are paid. They record where time went, not what you earn.</span></li>
            <li class="flex gap-3"><span class="text-ink-400">&#10007;</span><span>Ghosting. If it is a no after a conversation, you get the no and the reason.</span></li>
            <li class="flex gap-3"><span class="text-ink-400">&#10007;</span><span>Hiring juniors to bill as seniors. The person on the call is the person doing the work.</span></li>
          </ul>
        </div>
      </div>
      <p class="mt-10 max-w-3xl text-sm text-ink-600">
        Want to see the standard before you apply? Read the <a href="/blog/" class="font-semibold text-brand-700 hover:text-brand-800">engineering blog</a>, the <a href="/learn/odoo-owl/" class="font-semibold text-brand-700 hover:text-brand-800">free OWL course</a>, or any of the <a href="/products/" class="font-semibold text-brand-700 hover:text-brand-800">published modules</a>. It is the same people writing all three.
      </p>
    </div>
  </section>

  <section class="section bg-ink-50 border-t border-ink-100">
    <div class="container-site max-w-3xl text-center">
      <h2 class="h2">Don't see your role?</h2>
      <p class="lede mt-4">We're always hiring exceptional Odoo people. Send us a note with your focus area and we'll find a fit.</p>
      <a href="/contact/" class="btn-primary mt-8">Send us your resume</a>
    </div>
  </section>
</Base>
