---
/*
 * Recent work.
 *
 * This URL used to list six anonymous case studies with one shared narrative
 * and one unattributed quote. They are gone (their URLs 301 here, see
 * public/_redirects). What replaced them is only what a visitor can check
 * for themselves: live demo systems we run, and the published App Store
 * listing of the module each one shows. No client names, numbers or quotes
 * appear here unless a client has agreed in writing to be named.
 */
import Base from '~/layouts/Base.astro';
import { SITE, LIVE_DEMOS, APP_STORE } from '~/data/site';
import { MODULE_CATALOG } from '~/data/modules-catalog';

const rows = LIVE_DEMOS.map(d => {
  const modules = d.products.flatMap(slug => {
    const m = MODULE_CATALOG[slug];
    if (!m) return [];
    const store = m.published && m.storeUrl?.startsWith('https://apps.odoo.com/') ? m.storeUrl : '';
    const features = (m.sections ?? []).map(sec => sec.heading).filter(Boolean).slice(0, 4);
    return [{ slug, name: m.name, store, features, version: m.version }];
  });
  return { ...d, host: new URL(d.url).hostname, modules };
});

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Recent work and live Odoo demos',
    url: `${SITE.url}/case-studies/`,
    hasPart: rows.map(r => ({ '@type': 'WebSite', name: r.title, url: r.url })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Recent work', item: `${SITE.url}/case-studies/` },
    ],
  },
];
---
<Base
  title="Recent Work: Live Odoo Demos and Modules"
  description={`${LIVE_DEMOS.length} live Odoo demo systems run by Way4Tech, each linked to the published Odoo App Store module it shows. Open them, then read the listings.`}
  structuredData={schema}
>
  <section class="bg-ink-900 text-white">
    <div class="container-site py-16 sm:py-24">
      <nav class="text-sm text-ink-300"><a href="/" class="hover:text-white">Home</a> / Recent work</nav>
      <div class="mt-6 max-w-3xl">
        <div class="eyebrow text-brand-300">Recent work</div>
        <h1 class="h1 mt-4">Work you can open, not just read about.</h1>
        <p class="lede mt-6 text-ink-300">
          Below are live Odoo systems we run as demos, each built on a module we publish. Every module links to its
          Odoo App Store listing, where the full feature list, screenshots and price are public. We have
          <a href={APP_STORE.url} class="underline decoration-white/30 hover:decoration-white" rel="noopener">{APP_STORE.count} modules on the store</a> in total.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-site">
      <div class="grid gap-5 md:grid-cols-2">
        {rows.map(r => (
          <article class="card flex flex-col">
            <div class="flex flex-wrap items-center gap-2 text-xs">
              <span class="chip">{r.kind === 'website' ? 'Website demo' : 'Odoo backend demo'}</span>
            </div>
            <h2 class="mt-3 text-lg font-semibold">{r.title}</h2>
            <p class="mt-2 text-sm text-ink-600">{r.what}</p>
            {r.modules.map(m => (
              <div class="mt-4 rounded-xl border border-ink-200 bg-ink-50 p-4">
                <div class="text-sm font-semibold text-ink-900">
                  <a href={`/products/${m.slug}/`} class="hover:text-brand-700">{m.name}</a>
                </div>
                {m.features.length > 0 && (
                  <ul class="mt-2 space-y-1 text-xs text-ink-600">
                    {m.features.map(f => <li>· {f}</li>)}
                  </ul>
                )}
                {m.store && (
                  <a href={m.store} rel="noopener" class="mt-3 inline-block text-xs font-semibold text-brand-600 hover:text-brand-700">Odoo App Store listing ↗</a>
                )}
              </div>
            ))}
            <div class="mt-auto pt-5">
              <a href={r.url} rel="noopener" target="_blank" class="btn-secondary">Open {r.host} ↗</a>
            </div>
          </article>
        ))}
      </div>

      <div class="mt-14 max-w-3xl">
        <h2 class="h3">Backend demos</h2>
        <p class="mt-3 text-ink-700">
          The Odoo backend demos open on a login page. Ask us for a demo login and we will send one, or
          <a href="/contact/?source=case-studies" class="text-brand-600 underline">book a walkthrough</a> and we will show you the system on a call.
        </p>
        <h2 class="h3 mt-10">Client projects</h2>
        <p class="mt-3 text-ink-700">
          Most of our client work runs on private servers under confidentiality, so we do not publish it here.
          If a reference matters to your decision, ask for one during scoping.
        </p>
      </div>
    </div>
  </section>
</Base>
