---
import Base from '~/layouts/Base.astro';
import { SITE, whatsappHref } from '~/data/site';

const pageUrl = `${SITE.url}/contact/`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: `Contact ${SITE.name}`,
    url: pageUrl,
    description: 'Talk to Way4Tech about an Odoo project. Free 30-minute consultation, reply within 4 business hours.',
    inLanguage: 'en',
    isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
    mainEntity: {
      '@type': 'Organization',
      name: SITE.name,
      url: SITE.url,
      email: SITE.email,
      telephone: SITE.phone,
      areaServed: SITE.locations,
      contactPoint: [{
        '@type': 'ContactPoint',
        contactType: 'sales',
        email: SITE.email,
        telephone: SITE.phone,
        availableLanguage: ['English', 'Arabic', 'Urdu'],
      }],
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Contact', item: pageUrl },
    ],
  },
];
---
<Base
  title="Contact"
  description="Get in touch with Way4Tech. Free 30-minute consultation for new projects. Email, WhatsApp, or book a call."
  structuredData={schema}
>
  <section class="bg-ink-900 text-white">
    <div class="container-site py-16 sm:py-24">
      <div class="max-w-3xl">
        <div class="eyebrow text-brand-300">Contact</div>
        <h1 class="h1 mt-4">Let's talk about your project.</h1>
        <p class="lede mt-6 text-ink-300">Free 30-minute consultation. No obligation, no sales pitch: just an honest conversation about what you're trying to build.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-site">
      <div class="grid gap-14 lg:grid-cols-5">
        <div class="lg:col-span-3">
          <h2 class="h3">Send us a message</h2>
          <p class="mt-3 text-ink-600">We respond within 4 business hours.</p>

          <form id="contactForm" class="mt-8 space-y-5">
            <!-- honeypot -->
            <input type="text" name="_hp" tabindex="-1" autocomplete="off" class="absolute left-[-9999px] w-0 h-0 opacity-0" aria-hidden="true" />
            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="lead-name" class="block text-sm font-medium text-ink-800">Your name *</label>
                <input type="text" name="name" id="lead-name" required autocomplete="name" class="mt-1.5 w-full rounded-lg border border-ink-200 px-4 py-2.5 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-100 outline-none" />
              </div>
              <div>
                <label for="lead-company" class="block text-sm font-medium text-ink-800">Company</label>
                <input type="text" name="company" id="lead-company" autocomplete="organization" class="mt-1.5 w-full rounded-lg border border-ink-200 px-4 py-2.5 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-100 outline-none" />
              </div>
            </div>

            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="lead-email" class="block text-sm font-medium text-ink-800">Email *</label>
                <input type="email" name="email" id="lead-email" required autocomplete="email" inputmode="email" class="mt-1.5 w-full rounded-lg border border-ink-200 px-4 py-2.5 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-100 outline-none" />
              </div>
              <div>
                <!--
                  Phone used to be the one optional field on the form and 18 of the first 41
                  leads arrived without one, so nearly half could only be answered by email.
                  Email is exactly the channel that lands in a spam folder and gets no reply.
                -->
                <label for="lead-phone" class="block text-sm font-medium text-ink-800">WhatsApp number *</label>
                <!--
                  The country code is enforced, not suggested. Numbers arrived as 9925938505
                  and 03024009117, which cannot be dialled or opened in WhatsApp from another
                  country, and the team answering sits in a different one from most senders.
                  The pattern mirrors the check in functions/api/lead.ts.
                -->
                <input type="tel" name="phone" id="lead-phone" required autocomplete="tel" inputmode="tel"
                       placeholder="+971 50 123 4567"
                       {/* No backslash escapes: the build strips them out of a plain
                           attribute and "^\s*(\+|00)..." shipped as "^s*(+|00)...", which is
                           invalid regex. A character class gets the same result literally.
                           HTML pattern is implicitly anchored, so no ^ or $ is needed. */}
                       pattern="([+]|00)[0-9 ()-]{6,}"
                       title="Start with your country code, for example +971 50 123 4567"
                       class="mt-1.5 w-full rounded-lg border border-ink-200 px-4 py-2.5 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-100 outline-none" />
                <p class="mt-1.5 text-xs text-ink-500">Start with your country code, for example +971 or +92. We need it to reach you on WhatsApp.</p>
              </div>
            </div>

            <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-4">
              <p class="text-sm font-medium text-emerald-900">WhatsApp gets you an answer the same hour</p>
              <p class="mt-1 text-sm leading-relaxed text-emerald-800">
                Email filters are unpredictable and our reply often lands in spam. Leave a WhatsApp
                number and we answer there instead, usually within minutes during working hours.
              </p>
              <a id="waLink" href={whatsappHref('/contact/')} target="_blank" rel="noopener" class="mt-3 inline-flex items-center gap-2 rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700">
                Message us on WhatsApp now
              </a>
            </div>

            <div>
              <label for="lead-service" class="block text-sm font-medium text-ink-800">What do you need? *</label>
              <select name="service" id="lead-service" required class="mt-1.5 w-full rounded-lg border border-ink-200 px-4 py-2.5 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-100 outline-none bg-white">
                <option value="">Select a service</option>
                <option>New Odoo implementation</option>
                <option>Custom module / customization</option>
                <option>Odoo support / maintenance</option>
                <option>Hire Odoo developer</option>
                <option>Migration / upgrade</option>
                <option>Integration with existing systems</option>
                <option>Product inquiry (specific module)</option>
                <option>Other / consultation</option>
              </select>
            </div>

            <div>
              <label for="lead-message" class="block text-sm font-medium text-ink-800">Tell us about your project *</label>
              <textarea name="message" id="lead-message" rows="5" required class="mt-1.5 w-full rounded-lg border border-ink-200 px-4 py-2.5 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-100 outline-none"></textarea>
            </div>

            <button type="submit" class="btn-primary" id="submitBtn">Send message</button>
            <p class="text-xs text-ink-500">We'll never share your info. Reply within 4 business hours, or in minutes on WhatsApp.</p>

            <noscript>
              <p class="rounded-lg border border-ink-200 bg-ink-50 p-4 text-sm text-ink-700">
                This form needs JavaScript to send. With it switched off, email
                <a class="font-medium text-brand-700 hover:text-brand-800" href={`mailto:${SITE.email}`}>{SITE.email}</a>
                or message us on <a class="font-medium text-brand-700 hover:text-brand-800" href={SITE.whatsapp} rel="noopener">WhatsApp</a>
                and we reply within 4 business hours.
              </p>
            </noscript>

            <div id="formResult" class="hidden"></div>
          </form>
        </div>

        <aside class="lg:col-span-2">
          <div class="space-y-6">
            <div class="rounded-2xl border border-ink-200 bg-white p-6">
              <h3 class="text-sm font-semibold">Direct contact</h3>
              <ul class="mt-4 space-y-3 text-sm">
                <li><a class="text-ink-700 hover:text-brand-600" href={`mailto:${SITE.email}`}>✉ {SITE.email}</a></li>
                <li><a class="text-ink-700 hover:text-brand-600" href={`mailto:${SITE.alt_email}`}>✉ {SITE.alt_email}</a></li>
                <li><a class="text-ink-700 hover:text-brand-600" href={SITE.whatsapp} target="_blank" rel="noopener">📱 WhatsApp {SITE.phone}</a></li>
                <li><a class="text-ink-700 hover:text-brand-600" href={`tel:${SITE.phone.replace(/\s/g,'')}`}>📞 {SITE.phone}</a></li>
              </ul>
            </div>

            <div class="rounded-2xl bg-ink-50 p-6">
              <h3 class="text-sm font-semibold">Service areas</h3>
              <ul class="mt-4 space-y-2 text-sm text-ink-700">
                {SITE.locations.map((l) => <li>📍 {l}</li>)}
              </ul>
              <p class="mt-4 text-xs text-ink-600">Remote-first with on-site visits available for major rollouts.</p>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <script is:inline>
    (function() {
      const form = document.getElementById('contactForm');
      const result = document.getElementById('formResult');
      const btn = document.getElementById('submitBtn');
      if (!form) return;

      const STORE_KEY = 'w4t_attribution';
      const UTM_KEYS = ['utm_source','utm_medium','utm_campaign','utm_term','utm_content'];
      // Fields worth remembering across a session. 'service' is deliberately absent: it would
      // silently override the visitor's own dropdown choice on a later visit.
      const TOUCH_KEYS = UTM_KEYS.concat(['source','country','product']);

      const qs = new URLSearchParams(location.search);
      const param = (k) => {
        const v = qs.get(k);
        return v ? String(v).trim().slice(0, 300) : '';
      };

      const isExternal = (url) => {
        if (!url) return false;
        try { return new URL(url, location.href).origin !== location.origin; } catch (e) { return false; }
      };

      // This script is is:inline, so it never sees the frontmatter. Reading the number off
      // the link already rendered on the page keeps one source of truth in site.ts rather
      // than hard-coding the WhatsApp URL a second time here.
      const waEl = document.getElementById('waLink');
      const waHref = (waEl && waEl.getAttribute('href')) || 'https://wa.me/923154114748';

      // sessionStorage throws outright in some privacy modes, so every touch is guarded.
      const readTouch = () => {
        try {
          const raw = sessionStorage.getItem(STORE_KEY);
          if (!raw) return null;
          const parsed = JSON.parse(raw);
          return parsed && typeof parsed === 'object' ? parsed : null;
        } catch (e) { return null; }
      };
      const writeTouch = (obj) => {
        try { sessionStorage.setItem(STORE_KEY, JSON.stringify(obj)); } catch (e) { /* storage unavailable */ }
      };

      // First-touch attribution. Written once per session, then only gap-filled, so the
      // original campaign and entry page survive the walk from landing page to this form.
      let touch = readTouch();
      let dirty = !touch;
      if (!touch) {
        touch = {
          landing_page: location.pathname + location.search,
          referrer: isExternal(document.referrer) ? document.referrer : '',
        };
      }
      TOUCH_KEYS.forEach(k => {
        const v = param(k);
        if (v && !touch[k]) { touch[k] = v; dirty = true; }
      });
      if (!touch.referrer && isExternal(document.referrer)) {
        touch.referrer = document.referrer;
        dirty = true;
      }
      if (dirty) writeTouch(touch);

      const setHidden = (name, value) => {
        if (!value) return;
        let input = form.querySelector('input[name="' + name + '"]');
        if (!input) {
          input = document.createElement('input');
          input.type = 'hidden';
          input.name = name;
          form.appendChild(input);
        }
        input.value = value;
        input.setAttribute('value', value); // survives form.reset()
      };

      // Prefill ?product= / ?country= / ?source= from URL, falling back to the
      // stored first touch. An explicit parameter on this URL always wins.
      ['product','country','source'].forEach(k => {
        setHidden(k, param(k) || touch[k] || '');
      });

      // `service` is a real <select> the visitor can see and change, so it is
      // preselected rather than shadowed. setHidden() looks for an <input> and
      // would not find the select, so it used to append a SECOND field with the
      // same name: the form then posted both, and the URL silently beat whatever
      // the visitor had chosen.
      const serviceParam = param('service');
      const serviceField = form.querySelector('select[name="service"]');
      if (serviceParam && serviceField) {
        const wanted = serviceParam.trim().toLowerCase();
        const match = Array.from(serviceField.options).find(
          o => o.value.trim().toLowerCase() === wanted
            || o.text.trim().toLowerCase() === wanted
        );
        if (match) serviceField.value = match.value;
      }
      UTM_KEYS.forEach(k => setHidden(k, param(k) || touch[k] || ''));

      setHidden('referrer', touch.referrer || (isExternal(document.referrer) ? document.referrer : ''));
      setHidden('landing_page', touch.landing_page || (location.pathname + location.search));

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        btn.disabled = true;
        btn.textContent = 'Sending...';
        const fd = new FormData(form);
        const data = Object.fromEntries(fd.entries());
        // Read the stored first touch again at submit time and fill only what is missing,
        // so anything explicit on this URL keeps priority.
        const stored = readTouch() || {};
        TOUCH_KEYS.concat(['referrer','landing_page']).forEach(k => {
          if (!data[k] && stored[k]) data[k] = stored[k];
        });
        if (!data.landing_page) data.landing_page = location.pathname + location.search;
        data.website = location.href;
        try {
          const resp = await fetch('/api/lead', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify(data),
          });
          const j = await resp.json().catch(() => ({}));
          if (resp.ok && j.ok) {
            result.className = 'rounded-lg bg-green-50 border border-green-200 p-4 text-sm text-green-900';
            // No user input is interpolated here, so the markup is fixed and safe.
            // The spam warning is deliberate: the acknowledgement mail is the message most
            // likely to be filtered, and it is the one that tells them we are coming.
            result.innerHTML =
              '<strong>Thanks, we have your message.</strong>' +
              '<p class="mt-1">A confirmation email is on its way. If it is not in your inbox within a few minutes, please check your spam folder and mark it as safe.</p>' +
              '<p class="mt-2">For a faster answer, message us on ' +
              '<a class="font-semibold underline" target="_blank" rel="noopener" href="' + waHref + '">WhatsApp</a>.</p>';
            form.reset();
          } else {
            throw new Error(j.error || 'Network error');
          }
        } catch (err) {
          result.className = 'rounded-lg bg-red-50 border border-red-200 p-4 text-sm text-red-900';
          // The server's own validation messages were being discarded, so a submission
          // rejected for a missing phone number told the visitor the site was down.
          var msg = (err && err.message) ? String(err.message) : '';
          result.textContent = (msg && msg !== 'Network error')
            ? msg
            : 'Could not submit right now. Please email info@way4tech.com or WhatsApp us.';
        }
        result.classList.remove('hidden');
        btn.disabled = false;
        btn.textContent = 'Send message';
      });
    })();
  </script>
</Base>
