---
import Base from '~/layouts/Base.astro';
import { SITE, COUNTRIES, SERVICES, SOLUTIONS, CASE_STUDIES, PRICING } from '~/data/site';
import { COUNTRY_DETAIL, SUPPORT_LABEL, COUNTRY_DETAIL_REVIEWED } from '~/data/country-detail';
import type { CountryDetail, CountryFact, CountryProvider, OdooSupport } from '~/data/country-detail';
/* Name aliases, region grouping, theme sniffing, product scoring and the support
   badge palette all live in ~/utils/country now, because this page was not the only
   copy. See the header of that file for why an import rather than a page const. */
import {
  REGION_OF,
  countryIndexOf,
  makeCaseRank,
  makeRotIdx,
  plainNameOf,
  regionOf,
  selectCountryProducts,
  supportClass,
  themesOf,
} from '~/utils/country';
import type { CaseRec, CountryRec, ProductRec } from '~/utils/country';

export function getStaticPaths() {
  return COUNTRIES.map(c => ({ params: { slug: c.slug }, props: { country: c } }));
}

const { country } = Astro.props;

const pageUrl = `${SITE.url}/countries/${country.slug}/`;
const countryIndex = countryIndexOf(country.slug);

const plainName = plainNameOf(country.title);

/* Region decides only the ordering of case studies and the sidebar country
   list. It is never printed as a claim. */
const myRegion = regionOf(country.slug);

/* Themes are read off the highlights this country already carries. No new fact
   is introduced: they only decide which existing services, products and modules
   get linked first. */
const themes = themesOf(country);

/* ── Services: compliance-led ordering, then the core stack ───────── */
const serviceOrder: string[] = ['odoo-localization'];
if (themes.einvoicing) serviceOrder.push('odoo-e-invoicing');
if (themes.payroll) serviceOrder.push('odoo-payroll-setup');
if (themes.pos) serviceOrder.push('odoo-pos-deployment');
serviceOrder.push(
  'odoo-implementation', 'odoo-customization', 'odoo-migration', 'odoo-support',
  'odoo-integration', 'hire-odoo-developer', 'odoo-training', 'odoo-saas-hosting',
  'odoo-consultancy', 'odoo-audit', 'odoo-ecommerce',
);
const serviceRank = (slug: string) => {
  const i = serviceOrder.indexOf(slug);
  return i === -1 ? 99 : i;
};
const countryServices = [...SERVICES].sort((a, b) => serviceRank(a.slug) - serviceRank(b.slug)).slice(0, 8);

/* ── Deterministic rotation so the filler tail differs page to page ── */
const rotIdx = makeRotIdx(countryIndex);

/* ── Products: scored against the highlight words of this country, then
   capped at 3 per category so 18 pages do not all show the same HRMS block. */
const countryProducts: ProductRec[] = selectCountryProducts(country, themes, countryIndex);

/* ── Case studies: exact country first, then same region ─────────── */
const caseRank = makeCaseRank(country);
const countryCases = CASE_STUDIES
  .map((cs: CaseRec, i: number) => ({ cs, i, rank: caseRank(cs) }))
  .sort((a, b) => a.rank - b.rank || rotIdx(a.i, CASE_STUDIES.length, 3) - rotIdx(b.i, CASE_STUDIES.length, 3))
  .slice(0, 3)
  .map(x => x.cs);
const hasNearWork = CASE_STUDIES.some((cs: CaseRec) => caseRank(cs) < 2);

/* ── Solutions: industries we have shipped in or near this country ── */
const INDUSTRY_TO_SOLUTION: Record<string, string> = {
  'Hospitality': 'hotel-hospitality',
  'Pharmacy': 'pharmacy',
  'Distribution': 'distribution-fmcg',
  'Healthcare': 'hospital-management',
  'Construction': 'construction',
  'Retail': 'retail-stores',
};
const prioritySolutions = new Set(
  CASE_STUDIES.filter((cs: CaseRec) => caseRank(cs) < 2)
    .map((cs: CaseRec) => INDUSTRY_TO_SOLUTION[cs.industry])
    .filter(Boolean),
);
const countrySolutions = SOLUTIONS
  .map((s, i) => ({ s, i, pri: prioritySolutions.has(s.slug) ? 0 : 1 }))
  .sort((a, b) => a.pri - b.pri || rotIdx(a.i, SOLUTIONS.length, 5) - rotIdx(b.i, SOLUTIONS.length, 5))
  .slice(0, 6)
  .map(x => x.s);

/* ── Sidebar: nearby countries first ─────────────────────────────── */
const others = COUNTRIES
  .map((c: CountryRec, i: number) => ({ c, i, near: myRegion && REGION_OF[c.slug] === myRegion ? 0 : 1 }))
  .filter(x => x.c.slug !== country.slug)
  .sort((a, b) => a.near - b.near || rotIdx(a.i, COUNTRIES.length, 4) - rotIdx(b.i, COUNTRIES.length, 4))
  .slice(0, 8)
  .map(x => x.c);

/* ── Localization detail ────────────────────────────────────────────
   Country facts live in country-detail.ts and are rendered verbatim.
   The lookup may miss: a country with no entry keeps the generic page,
   so every block below is guarded rather than assumed. Nothing here
   reaches the structured data. */
const detail: CountryDetail | undefined = COUNTRY_DETAIL[country.slug];

/* supportClass is imported: colour reads as cost to the buyer, and five pages
   share the same palette. */
const supportLabel = (s: OdooSupport) => SUPPORT_LABEL[s] || '';
const SUPPORT_LEGEND: OdooSupport[] = ['native', 'oca_or_community', 'third_party_paid', 'custom_build'];

/* Review date, printed as '22 August 2026'. Falls back to the raw
   string if the constant is ever not an ISO date. */
const reviewedStamp = new Date(`${COUNTRY_DETAIL_REVIEWED}T00:00:00Z`);
const reviewedOn = Number.isNaN(reviewedStamp.getTime())
  ? COUNTRY_DETAIL_REVIEWED
  : reviewedStamp.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });

/* Module strings are mostly 'l10n_xx' or 'l10n_xx (Label)', but a few
   markets list a prose line instead. Only the first form gets code
   styling; the rest render as plain lines so nothing is mangled. */
const MODULE_RE = /^(OCA\s+)?([a-z][a-z0-9]*(?:_[a-z0-9]+)+)\s*(.*)$/;
const moduleChips: { oca: boolean; code: string; note: string }[] = [];
const modulePlain: string[] = [];
for (const m of detail?.odoo?.modules || []) {
  const hit = MODULE_RE.exec(String(m).trim());
  if (!hit) { modulePlain.push(m); continue; }
  let note = (hit[3] || '').trim();
  if (note.startsWith('(') && note.endsWith(')')) note = note.slice(1, -1).trim();
  moduleChips.push({ oca: Boolean(hit[1]), code: hit[2], note });
}

const factSections: { id: string; title: string; intro: string; facts: CountryFact[] }[] = detail
  ? [
      { id: 'tax', title: `Tax in ${plainName}`, intro: `What the tax configuration has to get right before go-live.`, facts: detail.tax || [] },
      { id: 'payroll', title: `Payroll in ${plainName}`, intro: `What payroll has to calculate, withhold, and file.`, facts: detail.payroll || [] },
      { id: 'accounting', title: `Accounting in ${plainName}`, intro: `The reporting framework your books sit inside.`, facts: detail.accounting || [] },
    ].filter(s => s.facts.length > 0)
  : [];

const providerSections: { id: string; title: string; intro: string; items: CountryProvider[] }[] = detail
  ? [
      {
        id: 'payments',
        title: `Payment gateways in ${plainName}`,
        intro: `The providers a ${plainName} checkout actually needs, and how each one reaches Odoo.`,
        items: detail.payments || [],
      },
      {
        id: 'shipping',
        title: `Shipping and couriers in ${plainName}`,
        intro: `The carriers that move volume here, and what it takes to rate, label, and track them from Odoo.`,
        items: detail.shipping || [],
      },
    ].filter(s => s.items.length > 0)
  : [];

const hasCoverage = Boolean(detail && ((detail.odoo?.native?.length || 0) > 0 || (detail.odoo?.custom?.length || 0) > 0 || moduleChips.length > 0 || modulePlain.length > 0));

/* The five topic sub-pages carry the full detail. The sections below are the
   summary, so each one links down to its own page. Without these links the
   sub-pages are reachable only from the sitemap. */
const deepLinks = detail
  ? [
      { slug: 'e-invoicing',    label: 'E-invoicing',      show: Boolean(detail.einvoicing) },
      { slug: 'accounting-tax', label: 'Accounting and tax', show: (detail.tax?.length || 0) > 0 || (detail.accounting?.length || 0) > 0 },
      { slug: 'payroll',        label: 'Payroll',          show: (detail.payroll?.length || 0) > 0 },
      { slug: 'payments',       label: 'Payment gateways', show: (detail.payments?.length || 0) > 0 },
      { slug: 'shipping',       label: 'Shipping',         show: (detail.shipping?.length || 0) > 0 },
      { slug: 'cost',           label: 'What it costs',    show: true },
    ].filter(x => x.show)
  : [];

const jumpLinks = detail
  ? [
      { href: '#e-invoicing', label: 'E-invoicing', show: Boolean(detail.einvoicing) },
      { href: '#tax', label: 'Tax', show: factSections.some(s => s.id === 'tax') },
      { href: '#payroll', label: 'Payroll', show: factSections.some(s => s.id === 'payroll') },
      { href: '#accounting', label: 'Accounting', show: factSections.some(s => s.id === 'accounting') },
      { href: '#payments', label: 'Payments', show: providerSections.some(s => s.id === 'payments') },
      { href: '#shipping', label: 'Shipping', show: providerSections.some(s => s.id === 'shipping') },
      { href: '#odoo-coverage', label: 'What Odoo covers', show: hasCoverage },
    ].filter(x => x.show)
  : [];

/* ── FAQ: built from the country's own highlights plus delivery facts
   that hold for every country. No rates, mandates, thresholds or
   deadlines are introduced beyond the highlight strings themselves. */
/* FAQ: only questions true for every market, carrying no rate, mandate,
   threshold or deadline. The country's own highlights stay as on-page
   bullets and are deliberately NOT promoted into FAQPage schema, because
   those figures are not yet verified. */
const faqs: { q: string; a: string }[] = [];

faqs.push({
  q: `Do we need to be in ${country.cities[0]} to work with you?`,
  a: `No. Odoo projects are delivered remotely by default, and location inside ${plainName} rarely changes the plan or the price. We travel on-site for discovery workshops, user training, and go-live week when the work calls for it. Cities we cover for on-site visits: ${country.cities.join(', ')}.`,
});
faqs.push({
  q: `Which timezone and language does a ${plainName} project run in?`,
  a: `Delivery, documentation, and training run in English. Our teams also work in Arabic and Urdu. We hold working-hour overlap across GMT to GMT+11, with daily stand-ups and a written weekly report, so progress never depends on one call landing.`,
});
faqs.push({
  q: `Can Odoo run in ${country.currency} for a ${plainName} entity?`,
  a: `Yes. Odoo is multi-company and multi-currency, so your books can run in ${country.currency} while you buy or sell in other currencies. The locale code we set up for this market is ${country.lang}, and Odoo supports multi-language and right-to-left layouts where a deployment needs them.`,
});
faqs.push({
  q: `How long does an Odoo implementation in ${plainName} take?`,
  a: `Single-module projects run 3-4 weeks. Multi-module rollouts run 8-12 weeks. Multi-company or multi-country programmes run 4-9 months with phased go-lives. The ${plainName} localization items above are configured inside that build, not after it.`,
});
faqs.push({
  q: `What does an Odoo project in ${plainName} cost?`,
  a: `${PRICING[0].price} for a ${PRICING[0].name} scope (${PRICING[0].features.slice(0, 3).join(', ')}). ${PRICING[1].price} for a ${PRICING[1].name} rollout (${PRICING[1].features.slice(0, 3).join(', ')}). Larger multi-company programmes are priced on scope after discovery. Localization work is scoped and priced up front, not added later.`,
});
faqs.push({
  q: `Do you work with Odoo Community or Enterprise in ${plainName}?`,
  a: `Both, and we migrate in either direction. The choice comes down to how technical your team is and whether you need Studio, IoT, or MRP II. The ${plainName} configuration described on this page is done in whichever edition you run.`,
});

faqs.push({
  q: `Which Odoo versions do you work on?`,
  a: `Current releases, including Odoo 17, Odoo 18 and Odoo 19, on Community and on Enterprise. If you are on an older version the first question is whether to upgrade before or after the ${plainName} work, and that depends on how much of what you need already ships in the newer release.`,
});
faqs.push({
  q: `Can we see an Odoo demo before committing?`,
  a: `Yes. We set up an Odoo demo on your own data rather than a generic one, because the ${plainName} specifics are the part worth seeing. Ask and we will scope what to load.`,
});
faqs.push({
  q: `We are replacing spreadsheets or an older ERP system. Where does that start?`,
  a: `With the data, not the software. An ERP implementation in ${plainName} usually stalls on master data quality rather than configuration, so the first phase is deciding what comes across, what gets cleaned, and what stays behind.`,
});

/* ── What we actually are, in the words buyers use ─────────────────
   The audit found the country pages carried none of the provider
   synonyms people search: development company, consultant, service
   provider, ERP software. This paragraph says what we do in that
   vocabulary. It is descriptive, not a claim of tier or certification. */
/* British spelling in the markets that use it. One spelling per page, never both:
   printing both would read as keyword stuffing, which is what it would be. */
const BRITISH = ['united-kingdom', 'australia', 'india', 'pakistan', 'bangladesh', 'canada', 'oman', 'qatar', 'kuwait', 'bahrain', 'uae'];
const isBritish = BRITISH.includes(country.slug);
const custWord = isBritish ? 'customisation' : 'customization';
const licWord = isBritish ? 'licence' : 'license';

const whatWeAre = `We work as an Odoo development company and Odoo implementation partner for businesses in ${plainName}. That covers the whole engagement: consulting on whether Odoo fits, configuring it, writing the custom modules that fit requires, connecting it to the systems you already run, and supporting it afterwards. Our Odoo developers and consultants deliver remotely, and travel for discovery, training and go-live week.`;
const whatWeAreTwo = `If you are moving off spreadsheets or replacing older ERP software, an ERP migration is the shape of the project and the ${plainName} items on this page decide how hard it is. As ERP consultants we will say when Odoo is the right ERP solution for you and when it is not. We work on Odoo 17, 18 and 19, on Odoo Community and Odoo Enterprise, and on Odoo cloud hosting or your own servers. Odoo ${custWord}, an Odoo upgrade from an older release, and Odoo AMC and support contracts are all in scope. We will say plainly when the edition you run is the wrong one, and what the Enterprise ${licWord} would change.`;

/* ── hreflang ──────────────────────────────────────────────────────
   These pages are English. The only honest alternate is a
   self-referential English page targeted at this country's region,
   derived from the ISO region subtag in the country's lang code. We
   do not claim an Arabic, Turkish, German or French version exists. */
const regionSubtag = String(country.lang || '').split('-')[1] || '';
/* The eight Arabic-market pages are real alternates of these pages, so the pair
   is declared in both directions. Only these eight: claiming an Arabic version
   that does not exist would be worse than claiming none. */
const AR_MARKETS = ['saudi-arabia', 'uae', 'qatar', 'kuwait', 'oman', 'bahrain', 'egypt', 'jordan'];
/* Turkey is the one market with a Turkish page, at /tr/turkey/. That page names
   this URL as its English alternate, so declaring the reverse here makes the
   pair reciprocal. Only turkey: no other market has a Turkish version, and
   claiming one that does not exist would be worse than claiming none. */
const hreflangAlternates = [
  ...(regionSubtag ? [{ lang: `en-${regionSubtag.toUpperCase()}`, href: pageUrl }] : []),
  ...(AR_MARKETS.includes(country.slug)
    ? [{ lang: 'ar', href: `${SITE.url}/ar/${country.slug}/` }, { lang: 'en', href: pageUrl }]
    : []),
  ...(country.slug === 'turkey'
    ? [{ lang: 'tr', href: `${SITE.url}/tr/turkey/` }, { lang: 'en', href: pageUrl }]
    : []),
];

const metaDescription = `Odoo implementation, customization, development and support in ${plainName}. ${country.tagline}`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: `Odoo ERP implementation and support in ${country.title}`,
    serviceType: 'Odoo ERP implementation, customization, localization and support',
    // Kept free of tax rates and scheme names on purpose: structured data is the
    // wrong place to assert a regulatory claim. The detail lives in the page body.
    description: `Odoo implementation, localization, customization and support for businesses in ${plainName}.`,
    url: pageUrl,
    provider: {
      '@type': 'Organization',
      name: SITE.name,
      url: SITE.url,
      email: SITE.email,
      telephone: SITE.phone,
    },
    areaServed: [
      { '@type': 'Country', name: plainName },
      ...country.cities.map((c: string) => ({ '@type': 'City', name: c })),
    ],
    availableChannel: {
      '@type': 'ServiceChannel',
      serviceUrl: `${SITE.url}/contact/`,
      availableLanguage: ['English', 'Arabic', 'Urdu'],
    },
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: `Odoo services in ${country.title}`,
      itemListElement: countryServices.map(s => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: s.title, url: `${SITE.url}/services/${s.slug}/` },
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Countries', item: `${SITE.url}/countries/` },
      { '@type': 'ListItem', position: 3, name: country.title, item: `${SITE.url}/countries/${country.slug}/` },
    ],
  },
];

const contactHref = `/contact/?country=${encodeURIComponent(country.title)}&source=countries/${country.slug}`;
---
<Base
  title={`Odoo Partner in ${country.title}: Implementation, Customization, Support`}
  description={metaDescription}
  structuredData={schema}
  hreflang={hreflangAlternates}
>
  <section class="relative overflow-hidden bg-ink-900 text-white">
    <div class="absolute inset-0" style="background-image: radial-gradient(circle at 15% 10%, rgba(135,90,123,0.55) 0%, transparent 45%), radial-gradient(circle at 85% 90%, rgba(0,160,157,0.3) 0%, transparent 50%);"></div>
    <div class="container-site relative py-16 sm:py-24">
      <nav class="text-sm text-brand-200"><a href="/" class="hover:text-white">Home</a> / <a href="/countries/" class="hover:text-white">Countries</a> / <span class="text-white">{country.title}</span></nav>
      <div class="mt-6 max-w-3xl">
        <div class="text-6xl">{country.flag}</div>
        <h1 class="h1 mt-6">Odoo Partner in {country.title}</h1>
        <p class="lede mt-6 text-ink-200">{country.tagline}</p>
        <div class="mt-6 flex flex-wrap gap-2">
          {country.cities.map((c: string) => <span class="chip !bg-white/10 !text-white">{c}</span>)}
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-ink-200 bg-ink-50 py-8">
    <div class="container-site">
      <dl class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wider text-ink-500">Reporting currency</dt>
          <dd class="mt-1 text-xl font-bold text-ink-900">{country.currency}</dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wider text-ink-500">Locale code</dt>
          <dd class="mt-1 text-xl font-bold text-ink-900">{country.lang}</dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wider text-ink-500">Cities covered</dt>
          <dd class="mt-1 text-xl font-bold text-ink-900">{country.cities.length}</dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wider text-ink-500">Odoo versions</dt>
          <dd class="mt-1 text-xl font-bold text-ink-900">v12 to v19</dd>
        </div>
      </dl>
    </div>
  </section>

  {jumpLinks.length > 0 && (
    <section class="border-b border-ink-200 bg-white py-4">
      <div class="container-site flex flex-wrap items-center gap-x-6 gap-y-2">
        <span class="text-xs font-semibold uppercase tracking-wider text-ink-500">Jump to</span>
        {jumpLinks.map(l => (
          <a href={l.href} class="text-sm font-semibold text-brand-600 hover:text-brand-700">{l.label}</a>
        ))}
      </div>
    </section>
  )}

  {deepLinks.length > 0 && (
    <section class="bg-ink-50 py-5">
      <div class="container-site">
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
          <span class="text-xs font-semibold uppercase tracking-wider text-ink-500">Full detail for {plainName}</span>
          {deepLinks.map(l => (
            <a href={`/countries/${country.slug}/${l.slug}/`} class="chip hover:bg-brand-100 hover:text-brand-700">{l.label} &rarr;</a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container-site">
      <div class="grid gap-14 lg:grid-cols-3">
        <div class="lg:col-span-2">
          <h2 class="h3">Odoo localization in {country.title}</h2>
          <p class="mt-4 text-lg text-ink-700">
            A {plainName} deployment is not a stock Odoo install with the currency swapped. Tax handling, invoice layout,
            payroll rules, and the reports your accountant actually files all have to line up before go-live. These are the
            {' '}{plainName} items we configure and test as part of the build:
          </p>
          <ul class="mt-6 space-y-3">
            {country.highlights.map((h: string) => (
              <li class="flex gap-3">
                <span class="mt-1 inline-flex h-6 w-6 flex-none items-center justify-center rounded-full bg-brand-100 text-brand-700 text-xs font-bold">✓</span>
                <span class="text-ink-700">{h}</span>
              </li>
            ))}
          </ul>
          {detail && (
            <p class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-2 rounded-xl border border-ink-200 bg-white px-4 py-3 text-sm">
              <span class="inline-flex items-center rounded-full bg-emerald-50 px-2.5 py-1 text-[11px] font-semibold text-emerald-700 ring-1 ring-emerald-200">Checked</span>
              <span class="text-ink-700">Localization notes on this page checked on {reviewedOn}.</span>
            </p>
          )}
          <p class="mt-6 rounded-xl bg-ink-50 p-5 text-sm text-ink-700">
            Rates, filing formats, thresholds, and submission windows change. We configure against the rules in force at
            build time and confirm every figure with your accountant or tax advisor before sign-off. If a rule moves after
            go-live, it is a support ticket, not a rebuild. Read more on our
            {' '}<a href="/services/odoo-localization/" class="font-semibold text-brand-600 hover:text-brand-700">Odoo localization service</a>.
          </p>

          {detail?.einvoicing && (
            <section id="e-invoicing" class="mt-14 scroll-mt-24">
              <h2 class="h3">E-invoicing in {plainName}</h2>
              <p class="mt-3 text-ink-700">The scheme, who it binds, and what it makes your system do.</p>
              <div class="mt-6 overflow-hidden rounded-2xl border border-brand-200">
                <div class="bg-brand-50 p-6 sm:p-8">
                  <div class="flex flex-wrap items-center gap-3">
                    <span class="eyebrow">Scheme</span>
                    {detail.einvoicing.verified === false && (
                      <span class="inline-flex items-center rounded-full border border-dashed border-ink-300 bg-white px-2.5 py-1 text-[11px] font-semibold text-ink-500">Unconfirmed</span>
                    )}
                  </div>
                  <p class="mt-3 text-2xl font-bold leading-snug text-brand-800 sm:text-3xl">{detail.einvoicing.scheme}</p>
                  <p class="mt-4 text-sm text-ink-700"><span class="font-semibold text-ink-900">Authority:</span> {detail.einvoicing.authority}</p>
                </div>
                <div class="space-y-6 bg-white p-6 sm:p-8">
                  {detail.einvoicing.status && (
                    <div>
                      <div class="text-xs font-semibold uppercase tracking-wider text-ink-500">Where it stands</div>
                      <p class="mt-2 text-ink-700">{detail.einvoicing.status}</p>
                    </div>
                  )}
                  
                  {(detail.einvoicing.requirements?.length || 0) > 0 && (
                    <div>
                      <div class="text-xs font-semibold uppercase tracking-wider text-ink-500">What it requires</div>
                      <ul class="mt-3 space-y-3">
                        {detail.einvoicing.requirements.slice(0, 2).map((r: string) => (
                          <li class="flex gap-3">
                            <span class="mt-2 h-1.5 w-1.5 flex-none rounded-full bg-brand-500"></span>
                            <span class="text-ink-700">{r}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                </div>
              </div>
            </section>
          )}

          {factSections.map(sec => (
            <section id={sec.id} class="mt-14 scroll-mt-24">
              <h2 class="h3">{sec.title}</h2>
              <p class="mt-3 text-ink-700">{sec.intro}</p>
              <ul class="mt-6 space-y-3">
                {sec.facts.map((f: CountryFact) => (
                  <li class={f.verified === false
                    ? 'rounded-xl border border-dashed border-ink-300 bg-ink-50 p-4 sm:p-5'
                    : 'rounded-xl border border-ink-200 bg-white p-4 sm:p-5'}>
                    <p class="text-ink-700">{f.claim}</p>
                    {f.verified === false && (
                      <p class="mt-2 text-[11px] font-semibold uppercase tracking-wider text-ink-500">Unconfirmed</p>
                    )}
                  </li>
                ))}
              </ul>
            </section>
          ))}

          {providerSections.map(sec => (
            <section id={sec.id} class="mt-14 scroll-mt-24">
              <h2 class="h3">{sec.title}</h2>
              <p class="mt-3 text-ink-700">{sec.intro}</p>
              {sec.id === 'payments' && (
                <div class="mt-4 flex flex-wrap items-center gap-2">
                  <span class="text-xs font-semibold uppercase tracking-wider text-ink-500">What the badges mean</span>
                  {SUPPORT_LEGEND.map((s: OdooSupport) => (
                    <span class={`inline-flex items-center rounded-full px-2.5 py-1 text-[11px] font-semibold ring-1 ${supportClass(s)}`}>{supportLabel(s)}</span>
                  ))}
                  <span class="inline-flex items-center rounded-full border border-dashed border-ink-300 bg-white px-2.5 py-1 text-[11px] font-semibold text-ink-500">Unconfirmed</span>
                </div>
              )}
              <div class="mt-6 grid gap-3 sm:grid-cols-2">
                {sec.items.map((p: CountryProvider) => (
                  <div class={p.verified === false
                    ? 'rounded-2xl border border-dashed border-ink-300 bg-ink-50 p-5'
                    : 'rounded-2xl border border-ink-200 bg-white p-5'}>
                    <div class="flex flex-wrap items-start justify-between gap-2">
                      <span class="font-semibold text-ink-900">{p.name}</span>
                      {p.verified === false ? (
                        <span class="inline-flex items-center rounded-full border border-dashed border-ink-300 bg-white px-2.5 py-1 text-[11px] font-semibold text-ink-500">{supportLabel(p.support)}, unconfirmed</span>
                      ) : (
                        <span class={`inline-flex items-center rounded-full px-2.5 py-1 text-[11px] font-semibold ring-1 ${supportClass(p.support)}`}>{supportLabel(p.support)}</span>
                      )}
                    </div>
                    <p class="mt-2 text-sm text-ink-600">{p.note}</p>
                  </div>
                ))}
              </div>
            </section>
          ))}

          {hasCoverage && detail && (
            <section id="odoo-coverage" class="mt-14 scroll-mt-24">
              <h2 class="h3">What Odoo covers out of the box in {plainName}</h2>
              <p class="mt-3 text-ink-700">
                The question behind every quote: how much of this is configuration and how much is a build. The first list
                ships with Odoo. The second is a paid connector, a community module, or work we scope and price up front.
              </p>
              <div class="mt-6 rounded-3xl bg-ink-900 p-6 text-white sm:p-8">
                {(moduleChips.length > 0 || modulePlain.length > 0) && (
                  <div>
                    <div class="text-xs font-semibold uppercase tracking-wider text-brand-200">Localization modules</div>
                    {moduleChips.length > 0 && (
                      <div class="mt-4 flex flex-wrap gap-2">
                        {moduleChips.map(m => (
                          <span class="inline-flex max-w-full items-baseline gap-2 rounded-lg bg-white/10 px-3 py-1.5 ring-1 ring-white/15">
                            {m.oca && <span class="text-[10px] font-bold uppercase tracking-wider text-brand-200">OCA</span>}
                            <code class="font-mono text-xs font-semibold text-white">{m.code}</code>
                            {m.note && <span class="text-xs text-white/60">{m.note}</span>}
                          </span>
                        ))}
                      </div>
                    )}
                    {modulePlain.length > 0 && (
                      <ul class="mt-4 space-y-2">
                        {modulePlain.map((m: string) => (
                          <li class="flex gap-3 text-sm text-white/70">
                            <span class="mt-2 h-1 w-1 flex-none rounded-full bg-white/40"></span>
                            <span>{m}</span>
                          </li>
                        ))}
                      </ul>
                    )}
                  </div>
                )}
                <div class="mt-8 grid gap-4 md:grid-cols-2">
                  <div class="rounded-2xl border border-emerald-400/30 bg-emerald-400/10 p-5">
                    <div class="flex items-center gap-2">
                      <span class="inline-flex h-6 w-6 flex-none items-center justify-center rounded-full bg-emerald-400/20 text-xs font-bold text-emerald-300">✓</span>
                      <span class="font-semibold">Covered</span>
                      <span class="ml-auto text-xs font-semibold text-emerald-300">{detail.odoo?.native?.length || 0}</span>
                    </div>
                    <ul class="mt-4 space-y-3">
                      {(detail.odoo?.native || []).map((n: string) => (
                        <li class="flex gap-3 text-sm text-white/80">
                          <span class="mt-1.5 h-1.5 w-1.5 flex-none rounded-full bg-emerald-400"></span>
                          <span>{n}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                  <div class="rounded-2xl border border-amber-400/30 bg-amber-400/10 p-5">
                    <div class="flex items-center gap-2">
                      <span class="inline-flex h-6 w-6 flex-none items-center justify-center rounded-full bg-amber-400/20 text-xs font-bold text-amber-300">!</span>
                      <span class="font-semibold">Needs work</span>
                      <span class="ml-auto text-xs font-semibold text-amber-300">{detail.odoo?.custom?.length || 0}</span>
                    </div>
                    <ul class="mt-4 space-y-3">
                      {(detail.odoo?.custom || []).map((c: string) => (
                        <li class="flex gap-3 text-sm text-white/80">
                          <span class="mt-1.5 h-1.5 w-1.5 flex-none rounded-full bg-amber-400"></span>
                          <span>{c}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>
              <p class="mt-5 text-sm text-ink-700">
                Everything under "Needs work" is quoted as scope, not discovered mid-project. Bring your own module
                list to a scoping call and we will mark it up the same way against {plainName}.
              </p>
            </section>
          )}

          <h2 class="h3 mt-14">Odoo services in {plainName}</h2>
          <p class="mt-4 text-ink-700">{whatWeAre}</p>
          <p class="mt-4 text-ink-700">{whatWeAreTwo}</p>
          <p class="mt-4 text-sm">
            <a class="font-semibold text-brand-600 hover:text-brand-700" href={`/countries/${country.slug}/cost/`}>Odoo pricing and what an Odoo project costs in {plainName}</a>
            <span class="text-ink-400"> and </span>
            <a class="font-semibold text-brand-600 hover:text-brand-700" href="/products/">the Odoo modules we publish</a>
          </p>

          <h2 class="h3 mt-14">How we deliver in {plainName}</h2>
          <p class="mt-4 text-ink-700">
            Delivery is remote-first. We do not claim a branch office in every city we serve, and we do not price one into
            your project. We travel on-site for discovery workshops, user training, and go-live week when the work calls
            for people in the room. What you get either way is senior engineers on the build.
          </p>
          <ul class="mt-6 space-y-4">
            <li class="flex gap-3">
              <span class="mt-1 inline-flex h-6 w-6 flex-none items-center justify-center rounded-full bg-accent-50 text-accent-600 text-xs font-bold">1</span>
              <span class="text-ink-700"><strong class="text-ink-900">Timezone overlap.</strong> Our teams hold working-hour overlap across GMT to GMT+11, so {country.cities[0]} gets live hours, not overnight email.</span>
            </li>
            <li class="flex gap-3">
              <span class="mt-1 inline-flex h-6 w-6 flex-none items-center justify-center rounded-full bg-accent-50 text-accent-600 text-xs font-bold">2</span>
              <span class="text-ink-700"><strong class="text-ink-900">English delivery, multilingual team.</strong> Documentation and training are in English. Our project teams also work in Arabic and Urdu.</span>
            </li>
            {themes.bilingual && (
              <li class="flex gap-3">
                <span class="mt-1 inline-flex h-6 w-6 flex-none items-center justify-center rounded-full bg-accent-50 text-accent-600 text-xs font-bold">3</span>
                <span class="text-ink-700"><strong class="text-ink-900">Bilingual output.</strong> Odoo runs multi-language and right-to-left, so bilingual invoices and interfaces are a configuration step rather than a custom build.</span>
              </li>
            )}
            <li class="flex gap-3">
              <span class="mt-1 inline-flex h-6 w-6 flex-none items-center justify-center rounded-full bg-accent-50 text-accent-600 text-xs font-bold">{themes.bilingual ? 4 : 3}</span>
              <span class="text-ink-700"><strong class="text-ink-900">Visible progress.</strong> Daily stand-ups, weekly demos, and a written weekly report. You see the build as it happens, not at handover.</span>
            </li>
            <li class="flex gap-3">
              <span class="mt-1 inline-flex h-6 w-6 flex-none items-center justify-center rounded-full bg-accent-50 text-accent-600 text-xs font-bold">{themes.bilingual ? 5 : 4}</span>
              <span class="text-ink-700"><strong class="text-ink-900">Test-database sign-off.</strong> Your team runs the {plainName} configuration in a test environment and approves it before cutover, with a rollback plan in writing.</span>
            </li>
            <li class="flex gap-3">
              <span class="mt-1 inline-flex h-6 w-6 flex-none items-center justify-center rounded-full bg-accent-50 text-accent-600 text-xs font-bold">{themes.bilingual ? 6 : 5}</span>
              <span class="text-ink-700"><strong class="text-ink-900">Support after go-live.</strong> SLA-backed contracts with 2h, 4h, or 8h response tiers, 24/7 monitoring, verified backups, and security patching.</span>
            </li>
          </ul>

          <h2 class="h3 mt-14">Odoo services we run in {plainName}</h2>
          <p class="mt-3 text-ink-700">Ordered by what the {plainName} scope above usually needs first.</p>
          <div class="mt-6 grid gap-3 sm:grid-cols-2">
            {countryServices.map(s => (
              <a href={`/services/${s.slug}/`} class="card group !p-4">
                <div class="flex items-center gap-2 text-sm">
                  <span class="text-xl">{s.icon}</span>
                  <span class="font-semibold">{s.title}</span>
                </div>
                <p class="mt-2 text-xs text-ink-600">{s.tagline}</p>
              </a>
            ))}
          </div>

          <h2 class="h3 mt-14">Industry builds for {plainName}</h2>
          <p class="mt-3 text-ink-700">
            {hasNearWork
              ? `Industries where we have delivered client work in or near ${plainName} appear first.`
              : `Industry-specific Odoo builds, each with its own module set and reports.`}
          </p>
          <div class="mt-6 grid gap-3 sm:grid-cols-2">
            {countrySolutions.map(s => (
              <a href={`/solutions/${s.slug}/`} class="card group !p-4">
                <div class="flex items-center gap-2 text-sm">
                  <span class="text-xl">{s.icon}</span>
                  <span class="font-semibold">{s.title}</span>
                </div>
                <p class="mt-2 text-xs text-ink-600">{s.tagline}</p>
              </a>
            ))}
          </div>

          <h2 class="h3 mt-14">Way4Tech modules for {plainName} projects</h2>
          <p class="mt-3 text-ink-700">
            Modules we build and maintain ourselves, ordered by how closely each one matches the {plainName} scope above.
            They ship as part of an implementation or drop into an Odoo instance you already run.
          </p>
          <div class="mt-6 grid gap-3 sm:grid-cols-2">
            {countryProducts.map((p: ProductRec) => (
              <a href={`/products/${p.slug}/`} class="card group !p-4">
                <div class="flex items-center justify-between gap-2">
                  <span class="text-sm font-semibold">{p.title}</span>
                  <span class="chip text-[10px]">{p.category}</span>
                </div>
                <p class="mt-2 text-xs text-ink-600">{p.tagline}</p>
              </a>
            ))}
          </div>
          <a href="/products/" class="mt-5 inline-block text-sm font-semibold text-brand-600 hover:text-brand-700">All Way4Tech modules →</a>

          <h2 class="h3 mt-14">{hasNearWork ? `Client work close to ${plainName}` : 'Selected client work'}</h2>
          <p class="mt-3 text-ink-700">
            {hasNearWork
              ? `Projects nearest to ${plainName} are listed first. Each card names the country the project ran in.`
              : `Odoo rollouts we have delivered elsewhere. Each card names the country the project ran in.`}
          </p>
          <div class="mt-6 space-y-4">
            {countryCases.map((cs: CaseRec) => (
              <a href={`/case-studies/${cs.slug}/`} class="card group block !p-5">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="chip">{cs.country}</span>
                  <span class="chip">{cs.industry}</span>
                </div>
                <div class="mt-3 font-semibold text-ink-900 group-hover:text-brand-700">{cs.title}</div>
                <p class="mt-2 text-sm text-ink-600">{cs.tagline}</p>
                <div class="mt-4 flex flex-wrap gap-5">
                  {cs.metrics.map((m: { k: string; v: string }) => (
                    <div>
                      <div class="text-lg font-bold text-brand-700">{m.v}</div>
                      <div class="text-[11px] uppercase tracking-wide text-ink-500">{m.k}</div>
                    </div>
                  ))}
                </div>
              </a>
            ))}
          </div>

          <h2 class="h3 mt-14">Cities we serve in {plainName}</h2>
          <p class="mt-3 text-ink-700">
            We deliver Odoo projects remotely and on-site across {plainName}. The cities below are the ones we cover for
            on-site work. Books run in {country.currency}, with multi-currency switched on where you trade across borders.
          </p>
          <div class="mt-5 flex flex-wrap gap-2">
            {country.cities.map((c: string) => <span class="chip">{c}</span>)}
          </div>
          <p class="mt-5 text-ink-700">
            Not on the list? Remote delivery is the default anyway, so location inside {plainName} rarely changes the plan
            or the price.
          </p>
        </div>

        <aside class="lg:col-span-1">
          <div class="sticky top-24 space-y-6">
            <div class="rounded-2xl bg-odoo-gradient p-6 text-white">
              <h3 class="text-lg font-semibold">Odoo in {country.title}?</h3>
              <p class="mt-2 text-sm text-brand-100">Free scoping call with a senior consultant who knows {country.title}.</p>
              <a href={contactHref} class="btn-primary w-full mt-5 bg-white !text-brand-700 hover:bg-brand-50">Book a call</a>
              <a href={SITE.whatsapp} target="_blank" rel="noopener" class="btn-secondary w-full mt-3 !bg-white/10 !border-white/30 !text-white hover:!bg-white/20">WhatsApp</a>
            </div>
            <div class="rounded-2xl border border-ink-200 bg-white p-6">
              <h3 class="text-sm font-semibold">{plainName} at a glance</h3>
              <dl class="mt-4 space-y-2 text-sm">
                <div class="flex justify-between gap-3"><dt class="text-ink-600">Currency</dt><dd class="font-semibold">{country.currency}</dd></div>
                <div class="flex justify-between gap-3"><dt class="text-ink-600">Locale</dt><dd class="font-semibold">{country.lang}</dd></div>
                <div class="flex justify-between gap-3"><dt class="text-ink-600">Cities</dt><dd class="font-semibold">{country.cities.length}</dd></div>
                <div class="flex justify-between gap-3"><dt class="text-ink-600">Delivery</dt><dd class="font-semibold">Remote plus on-site</dd></div>
              </dl>
            </div>
            <div class="rounded-2xl bg-ink-50 p-6">
              <h3 class="text-sm font-semibold">Other countries</h3>
              <ul class="mt-4 space-y-2">
                {others.map((o: CountryRec) => (
                  <li><a class="text-sm text-ink-700 hover:text-brand-600" href={`/countries/${o.slug}/`}>{o.flag} {o.title}</a></li>
                ))}
              </ul>
              <a href="/countries/" class="mt-4 inline-block text-sm font-semibold text-brand-600 hover:text-brand-700">All 18 countries →</a>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="section bg-ink-50">
    <div class="container-site">
      <div class="grid gap-10 lg:grid-cols-3">
        <div>
          <div class="eyebrow">Questions</div>
          <h2 class="h2 mt-3">Odoo in {plainName}</h2>
          <p class="lede mt-4">Straight answers on scope, cost, and how a {plainName} build actually runs. Still stuck? <a href={contactHref} class="text-brand-600 underline">Ask us directly</a>.</p>
        </div>
        <div class="lg:col-span-2 space-y-3">
          {faqs.map(f => (
            <details class="group rounded-xl border border-ink-200 bg-white open:bg-brand-50/30 open:border-brand-200">
              <summary class="flex cursor-pointer items-center justify-between gap-4 p-5 font-semibold">
                <span>{f.q}</span>
                <span class="text-brand-600 transition group-open:rotate-45">+</span>
              </summary>
              <p class="px-5 pb-5 text-ink-700">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-site">
      <div class="relative overflow-hidden rounded-3xl bg-odoo-gradient p-10 sm:p-16 text-white">
        <div class="absolute -right-20 -top-20 h-72 w-72 rounded-full bg-accent-400/30 blur-3xl"></div>
        <div class="relative max-w-2xl">
          <div class="text-4xl">{country.flag}</div>
          <h2 class="h2 mt-4 text-white">Scope your {plainName} Odoo project.</h2>
          <p class="lede mt-4 text-brand-100">
            A 30-minute call: your current stack, the {plainName} items above, and what a realistic first phase looks like.
            You leave with a written scope. No obligation, no sales script.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={contactHref} class="btn-primary bg-white !text-brand-700 hover:bg-brand-50">Book a scoping call</a>
            <a href={SITE.whatsapp} target="_blank" rel="noopener" class="btn-secondary !bg-white/10 !border-white/30 !text-white hover:!bg-white/20">WhatsApp us</a>
            <a href="/pricing/" class="btn-secondary !bg-white/10 !border-white/30 !text-white hover:!bg-white/20">See pricing</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
