---
import Base from '~/layouts/Base.astro';

/*
 * Live demo directory. One shareable page listing every Way4Tech demo with a
 * single, uniform, non-admin login (w4demo / Demo2026) seeded on each instance.
 * noindex: this is a sales/sharing tool, not an SEO page, and it repeats one
 * login across many cards — kept out of search on purpose.
 */

const USER = 'w4demo';
const PASS = 'Demo2026';

type Item = { name: string; host: string; tag: string; line: string; cred: 'std' | 'open' | string; http?: boolean };
type Group = { title: string; blurb: string; items: Item[] };

const GROUPS: Group[] = [
  {
    title: 'Flagship product demos',
    blurb: 'Our store apps, polished and ready to walk a buyer through.',
    items: [
      { name: 'Way4Tech ERP', host: 'erp-demo.way4tech.com', tag: 'ERP', line: 'Full ERP showcase across sales, inventory and accounting.', cred: 'std' },
      { name: 'Jewellery & Gold', host: 'jewelry-demo.way4tech.com', tag: 'Jewellery', line: 'Daily gold rate per gram, making and wastage, old-gold buy-back, hallmark and HUID, and stock by weight.', cred: 'std' },
      { name: 'Auto Parts Wholesale', host: 'autoparts-demo.way4tech.com', tag: 'Distribution', line: 'Trade-only dealer portal: approved dealers only, vehicle fitment search, dealer pricing, hot products and one-click reorder.', cred: 'dealer / Dealer2026' },
      { name: 'Real Estate Enterprise', host: 'realestate-pro.way4tech.com', tag: 'Property', line: 'Property management for a letting agency: post-dated cheque books with bounce handling, owner statements and payouts, maintenance, lease renewals with escalation, and a portfolio dashboard.', cred: 'std' },
      { name: 'Distribution & Van Sales', host: 'distributor-demo.way4tech.com', tag: 'Distribution', line: 'Wholesale distribution: salesman routes, orders at the shop, van stock, collections and live team tracking.', cred: 'daniel / demo' },
      { name: 'Garage Management', host: 'garage-demo.way4tech.com', tag: 'Automotive', line: 'Auto repair workshop: job cards, inspections, invoicing.', cred: 'std' },
      { name: 'Garage Enterprise', host: 'garage-pro.way4tech.com', tag: 'Automotive', line: 'Service plans, insurance and warranty claims, workshop boards.', cred: 'std' },
      { name: 'Facility / CAFM', host: 'facility-demo.way4tech.com', tag: 'Facility', line: 'Assets, planned maintenance, work orders and SLAs.', cred: 'std' },
      { name: 'Facility Enterprise', host: 'facility-pro.way4tech.com', tag: 'Facility', line: 'CAFM with contracts, analytics and technician mobile.', cred: 'std' },
      { name: 'Transport Management', host: 'transport-demo.way4tech.com', tag: 'Logistics', line: 'Fleet, trips, drivers and freight operations.', cred: 'std' },
      { name: 'Transport Enterprise', host: 'transport-pro.way4tech.com', tag: 'Logistics', line: 'Transport with costing, settlements and dashboards.', cred: 'std' },
      { name: 'Gym & Fitness', host: 'gym-demo.way4tech.com', tag: 'Fitness', line: 'Memberships, plans, check-in and classes.', cred: 'std' },
      { name: 'Kitchen Display (KDS)', host: 'kds-demo.way4tech.com', tag: 'Restaurant', line: 'Kitchen display system for POS restaurants.', cred: 'std' },
      { name: 'Legal Practice', host: 'legal-demo.way4tech.com', tag: 'Legal', line: 'Matters, time entries, documents and billing.', cred: 'std' },
      { name: 'HRMS & Payroll', host: 'hr19.way4tech.com', tag: 'HR', line: 'HR, leave, attendance, shifts, payroll and employee self service for a 55-person sample company.', cred: 'std' },
      { name: 'Labour Camp Management', host: 'labourcamp-demo.way4tech.com', tag: 'Facility', line: 'Worker accommodation bed by bed: allocation, visa and ID expiry, permits, inspections, mess, buses and monthly contractor billing.', cred: 'std' },
      { name: 'Business Dashboards', host: 'dashboards-demo.way4tech.com', tag: 'Analytics', line: 'Sales, CRM, purchase, inventory, POS, accounting and project dashboards on a year of trading data, plus the dashboard builder.', cred: 'std' },
      { name: 'Print Shop', host: 'printing-demo.way4tech.com', tag: 'Printing', line: 'Print jobs, estimates and production tracking.', cred: 'std' },
      { name: 'Rental Management', host: 'rental-demo.way4tech.com', tag: 'Rental', line: 'Rental orders, availability, pickup and return.', cred: 'std' },
      { name: 'Travel Agency', host: 'travel-demo.way4tech.com', tag: 'Travel', line: 'Bookings, itineraries and travel invoicing.', cred: 'std' },
      { name: 'Restaurant Suite', host: 'restro.way4tech.com', tag: 'Restaurant', line: 'Multi-branch restaurant POS, KDS, delivery and reports.', cred: 'std' },
      { name: 'Freight / Logistics', host: 'freight-demo.way4tech.com', tag: 'Logistics', line: 'Freight operations on Odoo 20.', cred: 'std' },
    ],
  },
  {
    title: 'Industry demos',
    blurb: 'Whole-business demos, one per industry.',
    items: [
      { name: 'Clinic / Medical', host: 'clinic.way4tech.com', tag: 'Healthcare', line: 'Patients, appointments and clinic billing.', cred: 'std' },
      { name: 'Hotel', host: 'hotel.way4tech.com', tag: 'Hospitality', line: 'Rooms, reservations and front desk.', cred: 'std' },
      { name: 'Salon & Spa', host: 'salon.way4tech.com', tag: 'Beauty', line: 'Appointments, stylists and salon POS.', cred: 'std' },
      { name: 'Restaurant', host: 'restaurant.way4tech.com', tag: 'Restaurant', line: 'Dine-in, menu and restaurant operations.', cred: 'std' },
      { name: 'School / Education', host: 'education.way4tech.com', tag: 'Education', line: 'Students, classes, fees and attendance.', cred: 'std' },
      { name: 'Events', host: 'event.way4tech.com', tag: 'Events', line: 'Event planning, tickets and attendees.', cred: 'std' },
      { name: 'E-commerce', host: 'ecommerce.way4tech.com', tag: 'Retail', line: 'Online store with catalogue and orders.', cred: 'std' },
      { name: 'Law Firm', host: 'lawfirm.way4tech.com', tag: 'Legal', line: 'Cases, clients and legal billing.', cred: 'std' },
      { name: 'NGO / Non-profit', host: 'ngo.way4tech.com', tag: 'Non-profit', line: 'Donors, projects and grant tracking.', cred: 'std' },
      { name: 'Photography Studio', host: 'photography.way4tech.com', tag: 'Creative', line: 'Shoots, packages and client galleries.', cred: 'std' },
      { name: 'Real Estate', host: 'realestate.way4tech.com', tag: 'Property', line: 'Listings, leads and property deals.', cred: 'std' },
      { name: 'Travel', host: 'travel.way4tech.com', tag: 'Travel', line: 'Travel packages and agency workflow.', cred: 'std' },
      { name: 'Consulting', host: 'consulting.way4tech.com', tag: 'Services', line: 'Projects, timesheets and consulting invoicing.', cred: 'std' },
      { name: 'Gym', host: 'gym.way4tech.com', tag: 'Fitness', line: 'Membership and fitness-centre management.', cred: 'std' },
      { name: 'Construction', host: 'construction.way4tech.com', tag: 'Construction', line: 'Projects, sites and construction costing.', cred: 'std' },
      { name: 'Car Wash', host: 'carwash-app.way4tech.com', tag: 'Automotive', line: 'Car wash bookings, packages and POS.', cred: 'std' },
      { name: 'Dental Clinic', host: 'dental-app.way4tech.com', tag: 'Healthcare', line: 'Dental charts, appointments and billing.', cred: 'std' },
      { name: 'Spa & Wellness', host: 'spa-app.way4tech.com', tag: 'Beauty', line: 'Spa bookings, therapists and packages.', cred: 'std' },
    ],
  },
  {
    title: 'More demos',
    blurb: 'Additional live instances.',
    items: [
      { name: 'Distributor / Van Sales', host: 'distrubutor.devcynx.com', tag: 'Distribution', line: 'Van sales, routes and distributor operations.', cred: 'std' },
      { name: 'Quick Salon POS', host: 'quicksalon.devcynx.com', tag: 'Beauty', line: 'Fast salon point of sale.', cred: 'std' },
      { name: 'Salon POS', host: 'salonpos.devcynx.com', tag: 'Beauty', line: 'Salon POS with appointments.', cred: 'std' },
      { name: 'Real Estate', host: 'realestate.devcynx.com', tag: 'Property', line: 'Property listings and deals.', cred: 'std' },
      { name: 'School Management', host: 'school.devcynx.com', tag: 'Education', line: 'School administration and fees.', cred: 'std' },
    ],
  },
  {
    title: 'Storefronts & tools',
    blurb: 'Public storefronts (just browse) and standalone tools.',
    items: [
      { name: 'E-shop Storefront', host: 'eshop.way4tech.com', tag: 'Storefront', line: 'Headless e-commerce storefront. Browse, no login.', cred: 'open' },
      { name: 'Shop Demo', host: 'shop-demo.way4tech.com', tag: 'Storefront', line: 'Online shop demo. Browse, no login.', cred: 'open' },
      { name: 'Fashion Store', host: 'fashion.way4tech.com', tag: 'Storefront', line: 'Fashion storefront. Browse, no login.', cred: 'open' },
      { name: 'SEO Tools Platform', host: 'seotool.way4tech.com', tag: 'Tool', line: 'Multi-site SEO audit platform. Team login.', cred: 'Team login' },
      { name: 'AI Quotation Drafting', host: 'quoteai.187.124.219.238.nip.io', tag: 'Tool', line: 'AI drafts quotations from a brief.', cred: 'estimator / Estimator-2026', http: true },
    ],
  },
];

const total = GROUPS.reduce((n, g) => n + g.items.length, 0);
const credText = (c: Item['cred']) => (c === 'std' ? `${USER} / ${PASS}` : c === 'open' ? '' : c);
---
<Base
  title="Live Demos"
  description="Open any Way4Tech Odoo demo instantly. Garage, facility, transport, restaurant, clinic, hotel, salon and more, each ready to explore."
  noindex={true}
>
  <section class="bg-ink-900 text-white">
    <div class="container-site py-14 sm:py-20">
      <div class="max-w-3xl">
        <div class="eyebrow text-brand-300">Live Demos</div>
        <h1 class="h1 mt-4">Pick a demo and explore it now</h1>
        <p class="lede mt-5 text-ink-300">{total} live Way4Tech demos. Open any one in a new tab, or copy a ready-to-send line for a client. Every Odoo demo opens with the same login.</p>
      </div>

      <div class="mt-8 rounded-2xl bg-odoo-gradient p-5 sm:p-6">
        <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
          <div class="text-sm font-semibold text-white">One login for every Odoo demo</div>
          <div class="flex flex-wrap items-center gap-2">
            <code class="rounded-md bg-white/20 px-2.5 py-1 text-sm text-white">{USER}</code>
            <button type="button" data-copy={USER} class="rounded-md border border-white/50 px-2.5 py-1 text-xs text-white hover:bg-white/20">Copy</button>
            <code class="rounded-md bg-white/20 px-2.5 py-1 text-sm text-white">{PASS}</code>
            <button type="button" data-copy={PASS} class="rounded-md border border-white/50 px-2.5 py-1 text-xs text-white hover:bg-white/20">Copy</button>
          </div>
        </div>
      </div>

      <div class="mt-6 max-w-md">
        <input id="demo-filter" type="search" placeholder="Filter demos by name or industry…" aria-label="Filter demos"
          class="w-full rounded-xl border border-white/20 bg-white/10 px-4 py-2.5 text-white placeholder:text-ink-300 focus:outline-none focus:ring-2 focus:ring-brand-300" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-site">
      {GROUPS.map(group => (
        <div class="demo-group mb-12 last:mb-0">
          <div class="mb-6">
            <h2 class="h2">{group.title}</h2>
            <p class="mt-1 text-ink-600">{group.blurb}</p>
          </div>
          <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {group.items.map(it => (
              <article
                class="demo-card flex flex-col rounded-2xl border border-ink-200 bg-white p-5"
                data-search={`${it.name} ${it.tag} ${it.host} ${it.line}`.toLowerCase()}
              >
                <span class="self-start rounded-full bg-ink-100 px-2.5 py-1 text-[0.68rem] font-bold uppercase tracking-wider text-brand-700">{it.tag}</span>
                <h3 class="mt-3 text-lg font-bold text-ink-900">{it.name}</h3>
                <p class="mt-1 flex-1 text-sm leading-relaxed text-ink-600">{it.line}</p>

                {it.cred === 'open' ? (
                  <div class="mt-3 text-sm font-semibold text-accent-600">Open, no login needed</div>
                ) : (
                  <div class="mt-3 flex flex-wrap items-center gap-2 text-sm">
                    <span class="text-xs uppercase tracking-wide text-ink-500">Login</span>
                    <code class="rounded bg-ink-100 px-2 py-0.5 text-xs text-ink-800">{credText(it.cred)}</code>
                  </div>
                )}

                <div class="mt-4 flex gap-2">
                  <a href={`${it.http ? 'http' : 'https'}://${it.host}/`} target="_blank" rel="noopener" class="btn-primary flex-1 justify-center px-3 text-sm">Open demo &#8599;</a>
                  <button type="button" class="btn-secondary px-3 text-sm"
                    data-name={it.name} data-url={`${it.http ? 'http' : 'https'}://${it.host}/`} data-login={credText(it.cred)}>Copy share</button>
                </div>

                <div class="mt-3 break-all font-mono text-[0.7rem] text-ink-400">{it.host}</div>
              </article>
            ))}
          </div>
        </div>
      ))}

      <p id="demo-empty" class="hidden py-10 text-center text-ink-500">No demos match that filter.</p>

      <p class="mt-10 border-t border-ink-100 pt-6 text-sm text-ink-500">
        The login above is a view-and-use demo account, not an administrator. Storefronts open without a login.
        For a guided walkthrough, <a href="/contact/" class="font-semibold text-brand-700 hover:text-brand-800">get in touch</a>.
      </p>
    </div>
  </section>

  <div id="demo-toast" class="pointer-events-none fixed left-1/2 bottom-6 z-50 -translate-x-1/2 rounded-lg bg-ink-900 px-4 py-2 text-sm text-white opacity-0 transition-opacity">Copied</div>

  <script is:inline>
    (function () {
      var toast = document.getElementById('demo-toast'), timer;
      function flash(msg) {
        if (!toast) return;
        toast.textContent = msg || 'Copied';
        toast.style.opacity = '1';
        clearTimeout(timer);
        timer = setTimeout(function () { toast.style.opacity = '0'; }, 1300);
      }
      function fallback(txt) {
        try {
          var ta = document.createElement('textarea');
          ta.value = txt; ta.style.position = 'fixed'; ta.style.opacity = '0';
          document.body.appendChild(ta); ta.select(); document.execCommand('copy');
          document.body.removeChild(ta); flash();
        } catch (e) { flash('Press Ctrl+C'); }
      }
      function copy(txt, msg) {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(txt).then(function () { flash(msg); }).catch(function () { fallback(txt); });
        } else { fallback(txt); }
      }
      document.addEventListener('click', function (e) {
        var c = e.target.closest('[data-copy]');
        if (c) { copy(c.getAttribute('data-copy')); return; }
        var s = e.target.closest('[data-name][data-url]');
        if (s) {
          var login = s.getAttribute('data-login');
          var txt = s.getAttribute('data-name') + ' demo: ' + s.getAttribute('data-url') + (login ? '\nLogin: ' + login : '');
          copy(txt, 'Share text copied');
        }
      });
      var q = document.getElementById('demo-filter');
      var cards = [].slice.call(document.querySelectorAll('.demo-card'));
      var groups = [].slice.call(document.querySelectorAll('.demo-group'));
      var empty = document.getElementById('demo-empty');
      if (q) q.addEventListener('input', function () {
        var v = q.value.trim().toLowerCase(), any = false;
        cards.forEach(function (card) {
          var hit = !v || card.getAttribute('data-search').indexOf(v) > -1;
          card.style.display = hit ? '' : 'none';
          if (hit) any = true;
        });
        groups.forEach(function (g) {
          var vis = g.querySelectorAll('.demo-card:not([style*="display: none"])').length;
          g.style.display = vis ? '' : 'none';
        });
        if (empty) empty.classList.toggle('hidden', any);
      });
    })();
  </script>
</Base>
