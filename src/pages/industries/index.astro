---
import Base from '~/layouts/Base.astro';
import { SITE, INDUSTRIES, SOLUTIONS } from '~/data/site';
import { INDUSTRY_DETAIL } from '~/data/industries-detail';

/* Industry pages answer "how does a rollout run in my sector".
   Solution pages answer "what does Odoo do for my sector".
   Only industries with written detail are listed, so the index never
   links to a page that does not exist. */
const industries = INDUSTRIES.flatMap((i) => {
  const detail = INDUSTRY_DETAIL[i.slug];
  return detail ? [{ ...i, summary: detail.summary }] : [];
});

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Industries', item: `${SITE.url}/industries/` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Odoo rollouts by industry',
    numberOfItems: industries.length,
    itemListElement: industries.map((i, n) => ({
      '@type': 'ListItem',
      position: n + 1,
      name: i.title,
      description: i.summary,
      url: `${SITE.url}/industries/${i.slug}/`,
    })),
  },
];
---
<Base
  title="Odoo by Industry: rollout plans for 8 sectors"
  description="How an Odoo rollout actually runs in retail, restaurants, healthcare, education, manufacturing, salons, logistics and real estate: the operational problems, the modules involved, the phase order, and what to prepare before kickoff."
  structuredData={schema}
>
  <section class="bg-ink-900 text-white">
    <div class="container-site py-16 sm:py-24">
      <nav class="text-sm text-ink-300"><a href="/" class="hover:text-white">Home</a> / <span class="text-white">Industries</span></nav>
      <div class="mt-6 max-w-3xl">
        <div class="eyebrow text-brand-300">Industries</div>
        <h1 class="h1 mt-4">Odoo by industry: what the rollout actually involves.</h1>
        <p class="lede mt-6 text-ink-300">Eight sectors we deliver in most. Each page covers the operational problems that come before the software, the modules that matter and why, the order the phases run in, and the data you need ready before kickoff.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/contact/?source=industries" class="btn-primary bg-white !text-brand-700 hover:bg-brand-50">Scope your rollout</a>
          <a href="/solutions/" class="btn-secondary !bg-white/5 !border-white/20 !text-white hover:!bg-white/10">Browse 20 solution pages</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-site">
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {industries.map((i) => (
          <a href={`/industries/${i.slug}/`} class="card group">
            <div class="flex items-center gap-3">
              <span class="text-3xl">{i.icon}</span>
              <h2 class="text-lg font-semibold">{i.title}</h2>
            </div>
            <p class="mt-3 text-sm text-ink-600">{i.summary}</p>
            <span class="mt-4 inline-block text-sm font-semibold text-brand-600 group-hover:text-brand-700">See the rollout →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section pt-0">
    <div class="container-site">
      <div class="rounded-3xl bg-ink-50 p-8 sm:p-12">
        <div class="grid gap-10 lg:grid-cols-3">
          <div class="lg:col-span-2">
            <div class="eyebrow">Industries or solutions?</div>
            <h2 class="h3 mt-3">Two different questions.</h2>
            <p class="mt-4 text-ink-700">The pages above are for the person who has already decided on Odoo and now has to plan the project: which phases, in what order, and what has to be true about the data first. If instead you want the feature-level view of what Odoo does in a sector, the solution pages cover 20 of them, including several not listed above.</p>
            <div class="mt-6 flex flex-wrap gap-3">
              <a href="/solutions/" class="btn-primary">All 20 solutions</a>
              <a href="/services/" class="btn-secondary">Delivery services</a>
              <a href="/modules/" class="btn-secondary">25 Odoo modules</a>
            </div>
          </div>
          <div>
            <h3 class="text-sm font-semibold">Sectors covered on the solution pages</h3>
            <ul class="mt-4 grid gap-2">
              {SOLUTIONS.filter(s => !INDUSTRY_DETAIL[s.slug]).slice(0, 12).map((s) => (
                <li><a class="text-sm text-ink-700 hover:text-brand-600" href={`/solutions/${s.slug}/`}>{s.icon} {s.title}</a></li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
