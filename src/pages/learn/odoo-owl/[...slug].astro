---
import Base from '~/layouts/Base.astro';
import { SITE } from '~/data/site';
import { getCollection } from 'astro:content';
import { COURSE_BASE, COURSE_TITLE, PART_BY_NUMBER } from '~/data/owl-course';

/*
 * One lesson per URL.
 *
 * The reading order is editorial: part, then order within the part. It is never
 * derived from the date, because correcting a lesson must not move it to the
 * front of the course.
 */
export async function getStaticPaths() {
  const all = (await getCollection('course')).filter(l => !l.data.draft);
  const ordered = all.sort(
    (a, b) => a.data.part - b.data.part || a.data.order - b.data.order,
  );
  return ordered.map((lesson, i) => ({
    params: { slug: lesson.slug },
    props: {
      lesson,
      prev: i > 0 ? ordered[i - 1] : null,
      next: i < ordered.length - 1 ? ordered[i + 1] : null,
      index: i + 1,
      total: ordered.length,
    },
  }));
}

const { lesson, prev, next, index, total } = Astro.props;
const { Content } = await lesson.render();
const d = lesson.data;
const part = PART_BY_NUMBER[d.part];

const url = new URL(`${COURSE_BASE}/${lesson.slug}/`, SITE.url).toString();
const courseUrl = new URL(`${COURSE_BASE}/`, SITE.url).toString();

/* A lesson is a learning resource inside a course, and saying so is the only
   way the two get treated as one thing rather than forty loose articles. */
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'LearningResource',
    '@id': `${url}#lesson`,
    name: d.title,
    description: d.description,
    url,
    learningResourceType: 'Lesson',
    educationalLevel: 'Professional',
    teaches: d.outcome,
    position: index,
    inLanguage: 'en',
    dateModified: d.updated.toISOString(),
    isPartOf: { '@type': 'Course', '@id': `${courseUrl}#course`, name: COURSE_TITLE, url: courseUrl },
    author: { '@type': 'Person', name: 'Waqas Riasat', url: new URL('/author/waqas-riasat/', SITE.url).toString() },
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Learn', item: new URL('/learn/', SITE.url).toString() },
      { '@type': 'ListItem', position: 2, name: 'Odoo OWL', item: courseUrl },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
];
---

<Base
  title={d.metaTitle || `${d.title} | Odoo OWL course`}
  description={d.description}
  canonical={url}
  ogType="article"
  modifiedTime={d.updated}
  structuredData={schema}
>
  <article class="mx-auto max-w-3xl px-4 py-10 sm:py-14">

    <nav class="mb-6 text-sm text-slate-500 dark:text-slate-400">
      <a href="/learn/" class="hover:underline">Learn</a>
      <span class="mx-1.5">/</span>
      <a href={`${COURSE_BASE}/`} class="hover:underline">Odoo OWL</a>
    </nav>

    <p class="text-xs font-semibold uppercase tracking-wider text-amber-700 dark:text-amber-500">
      Part {d.part}. {part?.title} &middot; lesson {index} of {total}
    </p>

    <h1 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">{d.title}</h1>

    <p class="mt-4 rounded-md border border-slate-200 bg-slate-50 px-4 py-3 text-[15px] dark:border-slate-700 dark:bg-slate-800/60">
      <span class="font-semibold">After this lesson you can:</span> {d.outcome}
    </p>

    <p class="mt-3 text-sm text-slate-500 dark:text-slate-400">
      Written against Odoo {d.versions.join(' and ')}. Last checked {d.updated.toISOString().slice(0, 10)}.
    </p>

    <div class="prose prose-slate mt-8 max-w-none dark:prose-invert prose-pre:text-[13px] prose-headings:scroll-mt-24">
      <Content />
    </div>

    <nav class="mt-12 grid gap-3 border-t border-slate-200 pt-6 sm:grid-cols-2 dark:border-slate-700">
      {prev ? (
        <a href={`${COURSE_BASE}/${prev.slug}/`} class="rounded-md border border-slate-200 px-4 py-3 hover:border-slate-400 dark:border-slate-700 dark:hover:border-slate-500">
          <span class="block text-xs uppercase tracking-wide text-slate-500 dark:text-slate-400">Previous</span>
          <span class="mt-0.5 block font-medium">{prev.data.title}</span>
        </a>
      ) : <span></span>}
      {next ? (
        <a href={`${COURSE_BASE}/${next.slug}/`} class="rounded-md border border-slate-200 px-4 py-3 text-right hover:border-slate-400 sm:text-right dark:border-slate-700 dark:hover:border-slate-500">
          <span class="block text-xs uppercase tracking-wide text-slate-500 dark:text-slate-400">Next</span>
          <span class="mt-0.5 block font-medium">{next.data.title}</span>
        </a>
      ) : <span></span>}
    </nav>

    <p class="mt-8 text-sm text-slate-500 dark:text-slate-400">
      <a href={`${COURSE_BASE}/`} class="hover:underline">Back to the full course</a>
    </p>

  </article>
</Base>
