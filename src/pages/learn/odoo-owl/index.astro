---
import Base from '~/layouts/Base.astro';
import { SITE } from '~/data/site';
import { getCollection } from 'astro:content';
import {
  COURSE_BASE, COURSE_DESCRIPTION, COURSE_PARTS, COURSE_PREREQS, COURSE_TITLE,
} from '~/data/owl-course';

const lessons = (await getCollection('course'))
  .filter(l => !l.data.draft)
  .sort((a, b) => a.data.part - b.data.part || a.data.order - b.data.order);

const byPart = COURSE_PARTS.map(part => ({
  part,
  lessons: lessons.filter(l => l.data.part === part.number),
})).filter(g => g.lessons.length > 0);

const url = new URL(`${COURSE_BASE}/`, SITE.url).toString();
const lastUpdated = lessons.length
  ? new Date(Math.max(...lessons.map(l => l.data.updated.getTime())))
  : new Date();

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Course',
    '@id': `${url}#course`,
    name: COURSE_TITLE,
    description: COURSE_DESCRIPTION,
    url,
    inLanguage: 'en',
    isAccessibleForFree: true,
    dateModified: lastUpdated.toISOString(),
    teaches: 'Building user interfaces inside Odoo with the OWL framework',
    educationalLevel: 'Professional',
    provider: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    author: { '@type': 'Person', name: 'Waqas Riasat', url: new URL('/author/waqas-riasat/', SITE.url).toString() },
    hasCourseInstance: {
      '@type': 'CourseInstance',
      courseMode: 'online',
      courseWorkload: 'PT20H',
    },
    syllabusSections: byPart.map(g => ({
      '@type': 'Syllabus',
      name: `Part ${g.part.number}. ${g.part.title}`,
      description: g.part.blurb,
      timeRequired: 'PT2H',
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Learn', item: new URL('/learn/', SITE.url).toString() },
      { '@type': 'ListItem', position: 2, name: 'Odoo OWL', item: url },
    ],
  },
];

let running = 0;
---

<Base
  title="Odoo OWL Course | Learn OWL Development Step by Step"
  description={COURSE_DESCRIPTION}
  canonical={url}
  structuredData={schema}
>
  <div class="mx-auto max-w-4xl px-4 py-10 sm:py-14">

    <nav class="mb-6 text-sm text-slate-500 dark:text-slate-400">
      <a href="/learn/" class="hover:underline">Learn</a>
    </nav>

    <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">{COURSE_TITLE}</h1>

    <p class="mt-4 max-w-2xl text-lg text-slate-600 dark:text-slate-300">
      OWL is the framework every screen in Odoo is built from. Learn it properly
      and the backend stops being something you configure around and becomes
      something you can change.
    </p>

    <p class="mt-4 max-w-2xl text-slate-600 dark:text-slate-300">
      {lessons.length} lessons, free, no sign up. Every lesson is written against
      a running Odoo and ships the code it describes. The faults in Part 7 are
      ones we hit on live systems, not ones invented to make a point.
    </p>

    <div class="mt-8 rounded-lg border border-slate-200 bg-slate-50 p-5 dark:border-slate-700 dark:bg-slate-800/60">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-700 dark:text-slate-200">
        What you need before you start
      </h2>
      <ul class="mt-3 space-y-2 text-[15px] text-slate-600 dark:text-slate-300">
        {COURSE_PREREQS.map(p => (
          <li class="flex gap-2">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-slate-400"></span>
            <span>{p}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="mt-10 space-y-10">
      {byPart.map(g => (
        <section>
          <h2 class="text-xl font-semibold tracking-tight">
            <span class="text-amber-700 dark:text-amber-500">Part {g.part.number}.</span> {g.part.title}
          </h2>
          <p class="mt-1.5 max-w-2xl text-slate-600 dark:text-slate-300">{g.part.blurb}</p>
          <ol class="mt-4 divide-y divide-slate-200 border-y border-slate-200 dark:divide-slate-700 dark:border-slate-700">
            {g.lessons.map(l => {
              running += 1;
              return (
                <li>
                  <a href={`${COURSE_BASE}/${l.slug}/`} class="group flex gap-4 py-3.5">
                    <span class="w-7 shrink-0 text-right text-sm tabular-nums text-slate-400">{running}</span>
                    <span class="min-w-0">
                      <span class="block font-medium group-hover:underline">{l.data.title}</span>
                      <span class="mt-0.5 block text-sm text-slate-500 dark:text-slate-400">{l.data.outcome}</span>
                    </span>
                  </a>
                </li>
              );
            })}
          </ol>
        </section>
      ))}
    </div>

    <div class="mt-12 rounded-lg border border-slate-200 p-5 dark:border-slate-700">
      <h2 class="font-semibold">Why this course exists</h2>
      <p class="mt-2 text-slate-600 dark:text-slate-300">
        We build and sell Odoo modules, so we write OWL every week and we carry
        the cost when it goes wrong. Most OWL material online is a rewording of
        the source. This is written the other way round, from the faults that
        reached production and what they taught us.
      </p>
      <p class="mt-3 text-slate-600 dark:text-slate-300">
        If you would rather we built it,
        <a href="/services/odoo-customization/" class="underline">that is what we do</a>.
      </p>
    </div>

  </div>
</Base>
