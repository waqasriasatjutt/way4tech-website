---
import Base from '~/layouts/Base.astro';
import { SITE, SERVICES, COUNTRIES } from '~/data/site';
import { SERVICE_DETAIL } from '~/data/services-detail';
import type { ServiceDetail } from '~/data/services-detail';
import { MODULE_CATALOG } from '~/data/modules-catalog';

export function getStaticPaths() {
  return SERVICES.map(s => ({ params: { slug: s.slug }, props: { service: s } }));
}

type ServiceRec = (typeof SERVICES)[number];
type CountryRec = (typeof COUNTRIES)[number];

const { service } = Astro.props as { service: ServiceRec };

/* Detail is keyed by the same slug as SERVICES. It is read defensively so a
   service without a detail entry still renders the page it rendered before. */
const detail: ServiceDetail | undefined = (SERVICE_DETAIL as Record<string, ServiceDetail | undefined>)[service.slug];

const strings = (v: unknown): string[] =>
  Array.isArray(v) ? v.filter((x): x is string => typeof x === 'string' && x.trim().length > 0) : [];

const pairs = (v: unknown): { title: string; body: string }[] =>
  Array.isArray(v)
    ? (v as { title?: unknown; body?: unknown }[])
        .filter(x => x && typeof x.title === 'string' && x.title.trim() && typeof x.body === 'string' && x.body.trim())
        .map(x => ({ title: String(x.title).trim(), body: String(x.body).trim() }))
    : [];

const intro = strings(detail?.intro);
const clientProvides = strings(detail?.clientProvides);
const outOfScope = strings(detail?.outOfScope);
const decisions = pairs(detail?.decisions);
const failureModes = pairs(detail?.failureModes);
const included = strings((service as { details?: unknown }).details);

const phases = Array.isArray(detail?.phases)
  ? detail!.phases
      .filter(p => p && typeof p.name === 'string' && p.name.trim())
      .map(p => ({
        name: p.name.trim(),
        goal: typeof p.goal === 'string' ? p.goal.trim() : '',
        work: strings(p.work),
        deliverable: typeof p.deliverable === 'string' ? p.deliverable.trim() : '',
      }))
  : [];

const faqs = Array.isArray(detail?.faqs)
  ? detail!.faqs.filter(f => f && typeof f.q === 'string' && f.q.trim() && typeof f.a === 'string' && f.a.trim())
  : [];

const pricingNote = typeof detail?.pricingNote === 'string' ? detail.pricingNote.trim() : '';
/* The engagement vocabulary buyers type. The audit found none of these on the
   site: odoo installation, odoo api, odoo data migration, odoo go-live,
   odoo performance, odoo health check. They belong here, on the service pages. */
const ENGAGEMENT: Record<string, string> = {
  'odoo-implementation': 'Odoo installation, configuration, data migration and Odoo go-live support are all inside this engagement, not billed as extras afterwards.',
  'odoo-customization': 'Custom modules, Odoo Studio work where Studio is enough, and the Odoo API where a screen is not the right answer.',
  'odoo-integration': 'Odoo API integration to the systems you already run, whether that is a REST endpoint, a file drop or a database view.',
  'odoo-migration': 'Odoo data migration and version upgrade, including the dry run that proves the numbers match before you commit to a go-live date.',
  'odoo-support': 'Odoo support and AMC contracts, covering fixes, small changes, upgrades and an Odoo performance review when the database grows.',
  'odoo-audit': 'An Odoo health check on the database you already run: Odoo optimization for speed, customisation debt, upgrade readiness and what it would cost to fix.',
  'odoo-saas-hosting': 'Odoo cloud hosting, on premise on your own servers, or self hosted in your data centre. Backups, monitoring and patching either way.',
  'hire-odoo-developer': 'Dedicated Odoo developers working to your backlog, in your timezone overlap, reporting the way your team already works.',
  'odoo-consultancy': 'Odoo consultants who will tell you when the answer is configuration, when it is a module, and when Odoo is the wrong fit.',
};
const engagementLine = ENGAGEMENT[service.slug] || '';

const countryNote = typeof detail?.countryNote === 'string' ? detail.countryNote.trim() : '';

/* These six have a page per market at /services/<slug>/<country>/. Without a link
   from here the whole cluster is reachable only from the sitemap. */
const CROSSED_SERVICES = ['odoo-implementation', 'odoo-customization', 'hire-odoo-developer', 'odoo-migration', 'odoo-support', 'odoo-integration'];
const hasCountryPages = CROSSED_SERVICES.includes(service.slug);
const lede = (typeof detail?.lede === 'string' && detail.lede.trim()) || service.tagline || '';

/* ── Modules ────────────────────────────────────────────────────────
   Two catalogue entries are published at an older slug, so the module
   page lives at that URL and not at the technical-name URL. Same map as
   src/pages/products/[slug].astro. Name and summary are printed from the
   catalogue verbatim, never rewritten here. */
const PRODUCT_ALIAS: Record<string, string> = {
  'wt-whatsapp-otp-odoo': 'wt-whatsapp-otp',
  'wt-barcode-scanner-offline': 'odoo-barcode-scanner',
};

const modules = (Array.isArray(detail?.modules) ? detail!.modules : [])
  .map(m => {
    const key = m && typeof m.slug === 'string' ? m.slug : '';
    const mod = key ? MODULE_CATALOG[key] : undefined;
    if (!mod) return null;
    const name = typeof mod.name === 'string' ? mod.name.trim() : '';
    if (!name) return null;
    return {
      href: `/products/${PRODUCT_ALIAS[key] || key}/`,
      name,
      summary: typeof mod.summary === 'string' ? mod.summary.trim() : '',
      category: typeof mod.category === 'string' ? mod.category.trim() : '',
      why: m && typeof m.why === 'string' ? m.why.trim() : '',
    };
  })
  .filter((m): m is { href: string; name: string; summary: string; category: string; why: string } => m !== null);

/* ── Countries ──────────────────────────────────────────────────────
   Slugs only. Every printed fact comes from COUNTRIES in site.ts. */
const countryBySlug = new Map(COUNTRIES.map((c: CountryRec) => [c.slug, c] as const));
const curatedCountries = strings(detail?.countries)
  .map(s => countryBySlug.get(s))
  .filter((c): c is CountryRec => Boolean(c));

/* Where per-country pages exist, every market gets a link. The curated ones lead,
   the rest follow: a country left out of the list here is a page nothing points at. */
const countries: CountryRec[] = hasCountryPages
  ? [...curatedCountries, ...COUNTRIES.filter((c: CountryRec) => !curatedCountries.some(x => x.slug === c.slug))]
  : curatedCountries;

/* ── Related services ───────────────────────────────────────────────
   Curated first, then filled from the rest so the block is never thin. */
const serviceBySlug = new Map(SERVICES.map((s: ServiceRec) => [s.slug, s] as const));
const curated = strings(detail?.related)
  .filter(s => s !== service.slug)
  .map(s => serviceBySlug.get(s))
  .filter((s): s is ServiceRec => Boolean(s));
const seenRelated = new Set(curated.map(s => s.slug));
const filler = SERVICES.filter((s: ServiceRec) => s.slug !== service.slug && !seenRelated.has(s.slug));
const related = [...curated, ...filler].slice(0, 5);
const sameCategory = SERVICES.filter((s: ServiceRec) => s.slug !== service.slug && s.category === service.category);

const pageUrl = `${SITE.url}/services/${service.slug}/`;
const contactHref = `/contact/?service=${encodeURIComponent(service.title)}&source=services/${service.slug}`;
const metaTitle = (typeof detail?.metaTitle === 'string' && detail.metaTitle.trim()) || service.title;
const metaDescription =
  (typeof detail?.metaDescription === 'string' && detail.metaDescription.trim()) || service.short;

const schema: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Services', item: `${SITE.url}/services/` },
      { '@type': 'ListItem', position: 3, name: service.title, item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: service.title,
    serviceType: service.title,
    url: pageUrl,
    description: metaDescription,
    category: service.category,
    provider: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    areaServed: countries.length > 0 ? countries.map(c => c.title) : SITE.locations,
    ...(included.length > 0
      ? {
          hasOfferCatalog: {
            '@type': 'OfferCatalog',
            name: `${service.title} deliverables`,
            itemListElement: included.map(d => ({
              '@type': 'Offer',
              itemOffered: { '@type': 'Service', name: d },
            })),
          },
        }
      : {}),
  },
];

if (faqs.length > 0) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}
---
<Base title={metaTitle} description={metaDescription} structuredData={schema}>
  <section class="bg-odoo-gradient text-white">
    <div class="container-site py-16 sm:py-24">
      <nav class="text-sm text-brand-200"><a href="/" class="hover:text-white">Home</a> / <a href="/services/" class="hover:text-white">Services</a> / <span class="text-white">{service.title}</span></nav>
      <div class="mt-6 max-w-3xl">
        <div class="flex items-center gap-3"><span class="text-5xl">{service.icon}</span><span class="chip !bg-white/10 !text-white">{service.category}</span></div>
        <h1 class="h1 mt-6">{service.title}</h1>
        {lede && <p class="lede mt-6 text-brand-100">{lede}</p>}
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={contactHref} class="btn-primary bg-white !text-brand-700 hover:bg-brand-50">Scope this work</a>
          <a href="/services/" class="btn-secondary !bg-white/5 !border-white/20 !text-white hover:!bg-white/10">All {SERVICES.length} services</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-site">
      <div class="grid gap-14 lg:grid-cols-3">
        <div class="lg:col-span-2">
          <p class="text-lg text-ink-700">{service.short}</p>

          {intro.length > 0 && (
            <div class="mt-6 space-y-5">
              {intro.map(p => <p class="text-ink-700">{p}</p>)}
            </div>
          )}

          {included.length > 0 && (
            <>
              <h2 class="h3 mt-12">What is included</h2>
              <ul class="mt-6 space-y-3">
                {included.map(d => (
                  <li class="flex gap-3">
                    <span class="mt-1 inline-flex h-6 w-6 flex-none items-center justify-center rounded-full bg-brand-100 text-brand-700 text-xs font-bold">✓</span>
                    <span class="text-ink-700">{d}</span>
                  </li>
                ))}
              </ul>
            </>
          )}

          {phases.length > 0 && (
            <>
              <h2 class="h3 mt-14">How the engagement runs</h2>
              <ol class="mt-6 space-y-8">
                {phases.map((p, idx) => (
                  <li class="flex gap-4">
                    <span class="inline-flex h-8 w-8 flex-none items-center justify-center rounded-full bg-brand-600 text-white text-sm font-bold">{idx + 1}</span>
                    <div class="min-w-0">
                      <h3 class="font-semibold text-ink-900">{p.name}</h3>
                      {p.goal && <p class="mt-1 text-ink-600">{p.goal}</p>}
                      {p.work.length > 0 && (
                        <ul class="mt-3 space-y-2">
                          {p.work.map(w => (
                            <li class="flex gap-2 text-sm text-ink-700">
                              <span class="mt-2 h-1.5 w-1.5 flex-none rounded-full bg-brand-400"></span>
                              <span>{w}</span>
                            </li>
                          ))}
                        </ul>
                      )}
                      {p.deliverable && (
                        <p class="mt-3 rounded-lg bg-ink-50 px-4 py-3 text-sm text-ink-700"><span class="font-semibold text-ink-900">You end up with:</span> {p.deliverable}</p>
                      )}
                    </div>
                  </li>
                ))}
              </ol>
            </>
          )}

          {clientProvides.length > 0 && (
            <>
              <h2 class="h3 mt-14">What you need to provide</h2>
              <p class="mt-3 text-ink-600">The schedule slips on these more often than on anything technical.</p>
              <ul class="mt-6 space-y-3">
                {clientProvides.map(c => (
                  <li class="flex gap-3">
                    <span class="mt-1 inline-flex h-6 w-6 flex-none items-center justify-center rounded-full bg-ink-100 text-ink-700 text-xs font-bold">→</span>
                    <span class="text-ink-700">{c}</span>
                  </li>
                ))}
              </ul>
            </>
          )}

          {decisions.length > 0 && (
            <>
              <h2 class="h3 mt-14">Decisions you will be asked to make</h2>
              <div class="mt-6 grid gap-4 sm:grid-cols-2">
                {decisions.map(d => (
                  <div class="rounded-2xl border border-ink-200 bg-white p-5">
                    <h3 class="font-semibold text-ink-900">{d.title}</h3>
                    <p class="mt-2 text-sm text-ink-700">{d.body}</p>
                  </div>
                ))}
              </div>
            </>
          )}

          {failureModes.length > 0 && (
            <>
              <h2 class="h3 mt-14">Where this goes wrong</h2>
              <p class="mt-3 text-ink-600">The failure modes we plan around, and what the plan does about each one.</p>
              <div class="mt-6 divide-y divide-ink-100 border-y border-ink-100">
                {failureModes.map(f => (
                  <div class="py-5">
                    <h3 class="font-semibold text-ink-900">{f.title}</h3>
                    <p class="mt-2 text-ink-700">{f.body}</p>
                  </div>
                ))}
              </div>
            </>
          )}

          {outOfScope.length > 0 && (
            <>
              <h2 class="h3 mt-14">Not included</h2>
              <p class="mt-3 text-ink-600">Stated up front so the proposal has no soft edges.</p>
              <ul class="mt-6 space-y-3">
                {outOfScope.map(o => (
                  <li class="flex gap-3">
                    <span class="mt-1 inline-flex h-6 w-6 flex-none items-center justify-center rounded-full bg-ink-100 text-ink-500 text-xs font-bold">×</span>
                    <span class="text-ink-700">{o}</span>
                  </li>
                ))}
              </ul>
            </>
          )}

          {pricingNote && (
            <>
              <h2 class="h3 mt-14">How this is priced</h2>
              <p class="mt-4 text-ink-700">{pricingNote}</p>
              <a href="/pricing/" class="mt-4 inline-block text-sm font-semibold text-brand-600 hover:text-brand-700">See the published bands →</a>
            </>
          )}

          {modules.length > 0 && (
            <>
              <h2 class="h3 mt-14">Modules that come up on this work</h2>
              <p class="mt-3 text-ink-600">Ready-built modules from our own catalogue. Where one of these covers the requirement, installing it beats writing it.</p>
              <div class="mt-6 grid gap-4 sm:grid-cols-2">
                {modules.map(m => (
                  <a href={m.href} class="card group !p-5">
                    <h3 class="font-semibold text-ink-900">{m.name}</h3>
                    {m.summary && <p class="mt-2 text-sm text-ink-600">{m.summary}</p>}
                    {m.why && <p class="mt-3 text-sm text-ink-700"><span class="font-semibold">Why here:</span> {m.why}</p>}
                    {m.category && <span class="mt-3 inline-block text-xs text-ink-400">{m.category}</span>}
                  </a>
                ))}
              </div>
            </>
          )}

          {countries.length > 0 && (
            <>
              {engagementLine && <p class="mt-14 text-lg text-ink-700">{engagementLine}</p>}
              <h2 class="h3 mt-10">Where we deliver this</h2>
              {countryNote && <p class="mt-3 text-ink-600">{countryNote}</p>}
              <div class="mt-6 grid gap-3 sm:grid-cols-2">
                {countries.map(c => (
                  <a href={hasCountryPages ? `/services/${service.slug}/${c.slug}/` : `/countries/${c.slug}/`} class="flex items-start gap-3 rounded-xl border border-ink-200 bg-white p-4 hover:border-brand-300">
                    <span class="text-2xl leading-none">{c.flag}</span>
                    <span class="min-w-0">
                      <span class="block font-semibold text-ink-900">{c.title}</span>
                      <span class="block text-sm text-ink-600">{c.tagline}</span>
                    </span>
                  </a>
                ))}
              </div>
              <a href="/countries/" class="mt-4 inline-block text-sm font-semibold text-brand-600 hover:text-brand-700">All {COUNTRIES.length} countries →</a>
            </>
          )}

          {faqs.length > 0 && (
            <>
              <h2 class="h3 mt-14">{service.title}: common questions</h2>
              <div class="mt-6 divide-y divide-ink-100 border-y border-ink-100">
                {faqs.map(f => (
                  <div class="py-5">
                    <h3 class="font-semibold text-ink-900">{f.q}</h3>
                    <p class="mt-2 text-ink-700">{f.a}</p>
                  </div>
                ))}
              </div>
            </>
          )}

          {related.length > 0 && (
            <>
              <h2 class="h3 mt-14">Read next</h2>
              <div class="mt-6 grid gap-4 sm:grid-cols-2">
                {related.map(r => (
                  <a href={`/services/${r.slug}/`} class="card group !p-5">
                    <div class="flex items-center gap-2"><span class="text-xl">{r.icon}</span><h3 class="font-semibold">{r.title}</h3></div>
                    <p class="mt-2 text-sm text-ink-600">{r.tagline}</p>
                  </a>
                ))}
              </div>
            </>
          )}
        </div>

        <aside class="lg:col-span-1">
          <div class="sticky top-24 space-y-6">
            <div class="rounded-2xl bg-odoo-gradient p-6 text-white">
              <h3 class="text-lg font-semibold">Scope {service.title}</h3>
              <p class="mt-2 text-sm text-brand-100">A 30-minute call, then a written scope with a fixed price or a transparent estimate.</p>
              <a href={contactHref} class="btn-primary w-full mt-5 bg-white !text-brand-700 hover:bg-brand-50">Get a quote</a>
              <a href={SITE.whatsapp} target="_blank" rel="noopener" class="btn-secondary w-full mt-3 !bg-white/10 !border-white/30 !text-white hover:!bg-white/20">WhatsApp</a>
            </div>

            {sameCategory.length > 0 && (
              <div class="rounded-2xl bg-ink-50 p-6">
                <h3 class="text-sm font-semibold">{service.category} services</h3>
                <ul class="mt-4 space-y-2">
                  {sameCategory.map(r => (
                    <li><a class="text-sm text-ink-700 hover:text-brand-600" href={`/services/${r.slug}/`}>{r.title}</a></li>
                  ))}
                </ul>
              </div>
            )}

            {countries.length > 0 && (
              <div class="rounded-2xl bg-ink-50 p-6">
                <h3 class="text-sm font-semibold">Country detail</h3>
                <ul class="mt-4 space-y-2">
                  {countries.map(c => (
                    <li><a class="text-sm text-ink-700 hover:text-brand-600" href={`/countries/${c.slug}/`}>{c.flag} {c.title}</a></li>
                  ))}
                </ul>
              </div>
            )}

            <div class="rounded-2xl bg-ink-50 p-6">
              <h3 class="text-sm font-semibold">Other services</h3>
              <ul class="mt-4 space-y-2">
                {related.map(r => (
                  <li><a class="text-sm text-ink-700 hover:text-brand-600" href={`/services/${r.slug}/`}>{r.title} <span class="text-ink-400">· {r.category}</span></a></li>
                ))}
              </ul>
              <a href="/services/" class="mt-4 inline-block text-sm font-semibold text-brand-600 hover:text-brand-700">See all {SERVICES.length} →</a>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="section bg-ink-50 border-t border-ink-100">
    <div class="container-site text-center">
      <h2 class="h2">Tell us what you are trying to fix</h2>
      <p class="lede mt-4 max-w-2xl mx-auto">A 30-minute call is usually enough to tell you whether this is a small piece of work or a project, and to say so before anyone writes a proposal.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={contactHref} class="btn-primary">Get a quote</a>
        <a href="/pricing/" class="btn-secondary">Pricing</a>
      </div>
    </div>
  </section>
</Base>
