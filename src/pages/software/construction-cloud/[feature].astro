---
import Base from '~/layouts/Base.astro';
import Shots from '~/components/suite/Shots.astro';
import { SITE } from '~/data/site';
import { CC, CC_FEATURES } from '~/data/construction-cloud';
import { GUIDE_PATH, chapterUrl, featureChapters } from '~/data/cc-guide';

export function getStaticPaths() {
  return CC_FEATURES.map(f => ({ params: { feature: f.slug }, props: { f } }));
}

const { f } = Astro.props;
const pageUrl = `${SITE.url}/software/construction-cloud/${f.slug}/`;
const others = CC_FEATURES.filter(o => o.slug !== f.slug);
const guide = featureChapters(f.slug);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Software', item: `${SITE.url}/software/` },
      { '@type': 'ListItem', position: 3, name: CC.name, item: `${SITE.url}/software/construction-cloud/` },
      { '@type': 'ListItem', position: 4, name: f.title, item: pageUrl },
    ],
  },
];
---
<Base title={f.seoTitle} description={f.description} structuredData={schema}>
  <section class="bg-odoo-gradient text-white">
    <div class="container-site py-16 sm:py-20">
      <nav class="text-sm text-brand-200" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white">Home</a> / <a href="/software/" class="hover:text-white">Software</a> / <a href="/software/construction-cloud/" class="hover:text-white">{CC.name}</a> / <span class="text-white">{f.title}</span>
      </nav>
      <div class="mt-6 max-w-3xl">
        <div class="eyebrow text-brand-200">{CC.name}</div>
        <h1 class="h1 mt-4">{f.title}</h1>
        <p class="lede mt-6 text-brand-100">{f.lede}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={CC.requestUrl} class="btn-primary bg-white !text-brand-700 hover:bg-brand-50">Request a demo</a>
          <a href={CC.demoUrl} target="_blank" rel="noopener" class="btn-secondary !bg-white/5 !border-white/20 !text-white hover:!bg-white/10">Try the demo &#8599;</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-site">
      <div class="grid gap-14 lg:grid-cols-3">
        <div class="lg:col-span-2">
          {f.sections.map((s, i) => (
            <div class={i === 0 ? '' : 'mt-12'}>
              <h2 class="h3">{s.heading}</h2>
              {s.body && <p class="mt-4 text-ink-700">{s.body}</p>}
              {s.bullets && (
                <ul class="mt-6 space-y-3">
                  {s.bullets.map(b => (
                    <li class="flex gap-3">
                      <span class="mt-1 inline-flex h-6 w-6 flex-none items-center justify-center rounded-full bg-brand-100 text-brand-700 text-xs font-bold">&#10003;</span>
                      <span class="text-ink-700">{b}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))}
          <h2 class="h3 mt-14">On screen</h2>
          <p class="mt-3 text-ink-600">From the demo company, Kestrel Construction.</p>
          <div class="mt-6"><Shots shots={f.shots} /></div>

          {guide.length > 0 && (
            <>
              <h2 class="h3 mt-14">Step by step in the user guide</h2>
              <p class="mt-3 text-ink-600">The chapters of the <a href={GUIDE_PATH} class="font-semibold text-brand-600 hover:text-brand-700">{CC.name} user guide</a> that cover this, with every screen and button.</p>
              <ul class="mt-6 grid gap-3 sm:grid-cols-2">
                {guide.map(c => (
                  <li>
                    <a href={chapterUrl(c)} class="card group block h-full">
                      <span class="text-xs font-semibold uppercase tracking-wider text-ink-500">Chapter {c.num}</span>
                      <span class="mt-1 block font-semibold text-ink-900 group-hover:text-brand-700">{c.title}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </>
          )}
        </div>

        <aside class="lg:col-span-1">
          <div class="sticky top-24 space-y-6">
            <div class="rounded-2xl bg-odoo-gradient p-6 text-white">
              <h2 class="text-lg font-semibold">{CC.name}</h2>
              <p class="mt-2 text-sm text-brand-100">Hosted construction management software, set up and supported by us.</p>
              <a href={CC.requestUrl} class="btn-primary w-full mt-5 bg-white !text-brand-700 hover:bg-brand-50">Request a demo</a>
              <a href="/software/construction-cloud/" class="btn-secondary w-full mt-3 !bg-white/10 !border-white/30 !text-white hover:!bg-white/20">Product overview</a>
            </div>
            {guide.length > 0 && (
              <div class="rounded-2xl border border-ink-200 p-6">
                <h2 class="text-sm font-semibold">In the user guide</h2>
                <ul class="mt-4 space-y-2">
                  {guide.map(c => (
                    <li><a class="text-sm text-ink-700 hover:text-brand-600" href={chapterUrl(c)}>{c.title}</a></li>
                  ))}
                </ul>
                <a href={GUIDE_PATH} class="mt-4 inline-block text-sm font-semibold text-brand-600 hover:text-brand-700">All chapters &rarr;</a>
              </div>
            )}
            <div class="rounded-2xl bg-ink-50 p-6">
              <h2 class="text-sm font-semibold">Other features</h2>
              <ul class="mt-4 space-y-2">
                {others.map(o => (
                  <li><a class="text-sm text-ink-700 hover:text-brand-600" href={`/software/construction-cloud/${o.slug}/`}>{o.title}</a></li>
                ))}
              </ul>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Base>
