---
import Base from '~/layouts/Base.astro';
import { SITE } from '~/data/site';
import { CC } from '~/data/construction-cloud';
import { CCG_CHAPTERS, CCG_PARTS, CCG_PDF, GUIDE_PATH, chapterHtml, chapterUrl, chaptersOfPart } from '~/data/cc-guide';
import '~/styles/cc-guide.css';

export function getStaticPaths() {
  return CCG_CHAPTERS.map((c, i) => ({
    params: { chapter: c.slug },
    props: { c, prev: CCG_CHAPTERS[i - 1], next: CCG_CHAPTERS[i + 1] },
  }));
}

const { c, prev, next } = Astro.props;
const part = CCG_PARTS[c.part];
const body = chapterHtml(c.slug);
const pageUrl = `${SITE.url}${chapterUrl(c)}`;
const seoTitle = `${c.title} | Construction Cloud guide`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: c.title,
    description: c.description,
    mainEntityOfPage: pageUrl,
    inLanguage: 'en',
    isPartOf: { '@type': 'CreativeWork', name: `${CC.name} user guide`, url: `${SITE.url}${GUIDE_PATH}` },
    about: { '@type': 'SoftwareApplication', name: CC.name, url: `${SITE.url}/software/construction-cloud/` },
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Software', item: `${SITE.url}/software/` },
      { '@type': 'ListItem', position: 3, name: CC.name, item: `${SITE.url}/software/construction-cloud/` },
      { '@type': 'ListItem', position: 4, name: 'User guide', item: `${SITE.url}${GUIDE_PATH}` },
      { '@type': 'ListItem', position: 5, name: c.title, item: pageUrl },
    ],
  },
];
---
<Base title={seoTitle} description={c.description} canonical={pageUrl} ogType="article" structuredData={schema}>
  <section class="bg-odoo-gradient text-white">
    <div class="container-site py-12 sm:py-16">
      <nav class="text-sm text-brand-200" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white">Home</a> / <a href="/software/construction-cloud/" class="hover:text-white">{CC.name}</a> / <a href={GUIDE_PATH} class="hover:text-white">User guide</a> / <span class="text-white">Chapter {c.num}</span>
      </nav>
      <div class="mt-6 max-w-3xl">
        <div class="eyebrow text-brand-200">{part.label}: {part.title}</div>
        <h1 class="mt-3 text-3xl font-bold leading-tight sm:text-4xl">{c.title}</h1>
        <p class="mt-4 text-brand-100">Chapter {c.num} of the {CC.name} user guide{c.figures > 0 && `, ${c.figures} screenshots`}.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-site grid gap-12 lg:grid-cols-12">
      <div class="min-w-0 lg:col-span-8">
        {c.sections.length > 2 && (
          <details class="mb-8 rounded-2xl border border-ink-200 p-5 lg:hidden">
            <summary class="cursor-pointer text-sm font-semibold text-ink-900">In this chapter ({c.sections.length} sections)</summary>
            <ul class="mt-3 space-y-2 text-sm">
              {c.sections.map(s => (<li><a href={`#${s.id}`} class="text-ink-700 hover:text-brand-700">{s.title}</a></li>))}
            </ul>
          </details>
        )}

        <article class="ccg" set:html={body} />

        <nav class="mt-14 grid gap-4 sm:grid-cols-2" aria-label="Chapters">
          {prev ? (
            <a href={chapterUrl(prev)} class="card group">
              <span class="text-xs font-semibold uppercase tracking-wider text-ink-500">&larr; Previous: Chapter {prev.num}</span>
              <span class="mt-1 block font-semibold text-ink-900 group-hover:text-brand-700">{prev.title}</span>
            </a>
          ) : (
            <a href={GUIDE_PATH} class="card group">
              <span class="text-xs font-semibold uppercase tracking-wider text-ink-500">&larr; Back</span>
              <span class="mt-1 block font-semibold text-ink-900 group-hover:text-brand-700">Guide contents</span>
            </a>
          )}
          {next && (
            <a href={chapterUrl(next)} class="card group sm:text-right">
              <span class="text-xs font-semibold uppercase tracking-wider text-ink-500">Next: Chapter {next.num} &rarr;</span>
              <span class="mt-1 block font-semibold text-ink-900 group-hover:text-brand-700">{next.title}</span>
            </a>
          )}
        </nav>

        <div class="mt-10 rounded-2xl bg-ink-50 p-8 text-center">
          <h2 class="text-xl font-semibold">See {CC.name} on your own jobs</h2>
          <p class="mt-2 text-ink-600">A walkthrough on the demo company, then a quote for your users, jobs and data migration.</p>
          <div class="mt-6 flex flex-wrap justify-center gap-3">
            <a href={CC.requestUrl} class="btn-primary">Request a demo</a>
            <a href="/software/construction-cloud/" class="btn-secondary">Product overview</a>
          </div>
        </div>
      </div>

      <aside class="lg:col-span-4">
        <div class="space-y-6 lg:sticky lg:top-24 lg:max-h-[calc(100vh-7rem)] lg:overflow-y-auto lg:pr-1">
          {c.sections.length > 2 && (
            <nav class="hidden rounded-2xl border border-ink-200 p-5 lg:block" aria-label="In this chapter">
              <p class="text-xs font-semibold uppercase tracking-wider text-ink-500">In this chapter</p>
              <ul class="mt-3 max-h-80 space-y-2 overflow-y-auto text-sm">
                {c.sections.map(s => (<li><a href={`#${s.id}`} class="text-ink-700 hover:text-brand-700">{s.title}</a></li>))}
              </ul>
            </nav>
          )}

          <nav class="rounded-2xl border border-ink-200 p-5" aria-label="Guide contents">
            <p class="text-xs font-semibold uppercase tracking-wider text-ink-500"><a href={GUIDE_PATH} class="hover:text-brand-700">Guide contents</a></p>
            <div class="mt-3 space-y-2">
              {CCG_PARTS.map(p => (
                <details open={p.index === c.part} class="group">
                  <summary class="cursor-pointer text-sm font-semibold text-ink-900">{p.label}: {p.title}</summary>
                  <ol class="mb-2 mt-2 space-y-1.5 border-l border-ink-200 pl-3 text-sm">
                    {chaptersOfPart(p.index).map(o => (
                      <li>
                        {o.slug === c.slug
                          ? <span class="font-semibold text-brand-700" aria-current="page">{o.num}. {o.title}</span>
                          : <a href={chapterUrl(o)} class="text-ink-700 hover:text-brand-700">{o.num}. {o.title}</a>}
                      </li>
                    ))}
                  </ol>
                </details>
              ))}
            </div>
          </nav>

          {CCG_PDF.length > 0 && (
            <div class="rounded-2xl border border-ink-200 p-5">
              <p class="text-xs font-semibold uppercase tracking-wider text-ink-500">Printable guide</p>
              <ul class="mt-2 space-y-2 text-sm">
                {CCG_PDF.map(f => (
                  <li><a href={f.url} class="font-semibold text-brand-700 hover:text-brand-800" download>PDF, {f.title}</a> <span class="text-xs text-ink-500">({f.pages} pages, {f.mb} MB)</span></li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </aside>
    </div>
  </section>
</Base>
