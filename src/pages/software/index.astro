---
import Base from '~/layouts/Base.astro';
import { CC, CC_FEATURES } from '~/data/construction-cloud';
---
<Base
  title="Hosted Business Software | Way4Tech Software"
  description="Hosted software from Way4Tech: complete systems we set up, run and support for you, starting with Construction Cloud for contractors."
>
  <section class="bg-ink-900 text-white">
    <div class="container-site py-16 sm:py-24">
      <div class="max-w-3xl">
        <div class="eyebrow text-brand-300">Software</div>
        <h1 class="h1 mt-4">Hosted software we run for you</h1>
        <p class="lede mt-6 text-ink-300">Complete systems for one industry, hosted, branded and supported by us. No modules to install and no server to look after. If you run your own Odoo, see our <a href="/suites/" class="underline hover:text-white">industry suites</a> instead.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-site">
      <a href="/software/construction-cloud/" class="card group grid gap-8 lg:grid-cols-2 lg:items-center">
        <div>
          <span class="badge">Construction</span>
          <h2 class="h2 mt-4">{CC.name}</h2>
          <p class="mt-4 text-ink-700">{CC.lede}</p>
          <ul class="mt-6 grid gap-2 sm:grid-cols-2">
            {CC_FEATURES.map(f => <li class="text-sm text-ink-700">&#10003; {f.title}</li>)}
          </ul>
          <span class="mt-6 inline-block font-semibold text-brand-600 group-hover:text-brand-700">See Construction Cloud &rarr;</span>
        </div>
        <img src="/software/construction-cloud/executive-dashboard.webp" width="1400" height="875" loading="lazy" decoding="async"
             alt="Construction Cloud executive dashboard" class="h-auto w-full rounded-2xl border border-ink-200 shadow-sm" />
      </a>
    </div>
  </section>
</Base>
