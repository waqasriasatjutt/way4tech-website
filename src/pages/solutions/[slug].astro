---
import Base from '~/layouts/Base.astro';
import { SITE, SOLUTIONS, INDUSTRIES, COUNTRIES } from '~/data/site';
import { INDUSTRY_DETAIL } from '~/data/industries-detail';
import { solutionDepth } from '~/data/solution-depth';

export function getStaticPaths() {
  return SOLUTIONS.map(s => ({ params: { slug: s.slug }, props: { sol: s } }));
}

const { sol } = Astro.props;
const related = SOLUTIONS.filter(s => s.slug !== sol.slug).slice(0, 6);

// 25 of the 37 solution slugs also exist under /industries/, where the page
// carries roughly 1,300 words against this one's 180. Two self-canonical URLs
// answering the same query split their own signals and let the thin one win by
// accident, so the deep page is declared canonical and this one becomes a
// navigational entry point that passes its authority along.
// The industries route only publishes slugs that have written detail, so the
// twin must be confirmed present in BOTH lists or this would point a canonical
// at a URL that was never built.
const twinExists =
  INDUSTRIES.some((i: any) => i.slug === sol.slug) &&
  Boolean(INDUSTRY_DETAIL[sol.slug]);
const canonical = twinExists ? `${SITE.url}/industries/${sol.slug}/` : undefined;

// Depth is only written for the 12 slugs that have no /industries/ twin and so
// stay self-canonical. Sending a canonicalised page more content would not help
// it rank, because it is deliberately not the URL competing for the query.
const depth = twinExists ? undefined : solutionDepth(sol.slug);

// sol.short is a full paragraph, so appending to it produced a description that
// every search engine truncated. It also asserted partner status, which the
// business cannot evidence.
const description =
  depth?.metaDescription ||
  `${sol.tagline} Odoo implementation, configuration and support from Way4Tech.`;

const countryBySlug = new Map(COUNTRIES.map((c: any) => [c.slug, c]));
const regional = (depth?.regional || []).filter(r => countryBySlug.has(r.country));

const schema: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: `Odoo for ${sol.title}`,
    provider: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    description: sol.short,
    areaServed: SITE.locations,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Solutions', item: `${SITE.url}/solutions/` },
      { '@type': 'ListItem', position: 3, name: sol.title, item: `${SITE.url}/solutions/${sol.slug}/` },
    ],
  },
];

// Never emit FAQPage on a page that canonicalises elsewhere: the rich result
// would be attributed to a URL that is not the canonical one.
if (!twinExists && depth?.faqs?.length) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: depth.faqs.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}
---
<Base
  title={`Odoo for ${sol.title}`}
  description={description}
  canonical={canonical}
  structuredData={schema}
>
  <section class="bg-odoo-gradient text-white">
    <div class="container-site py-16 sm:py-24">
      <nav class="text-sm text-brand-200"><a href="/" class="hover:text-white">Home</a> / <a href="/solutions/" class="hover:text-white">Solutions</a> / <span class="text-white">{sol.title}</span></nav>
      <div class="mt-6 max-w-3xl">
        <div class="text-5xl">{sol.icon}</div>
        <h1 class="h1 mt-6">Odoo for {sol.title}</h1>
        <p class="lede mt-6 text-brand-100">{sol.tagline}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-site">
      <div class="grid gap-14 lg:grid-cols-3">
        <div class="lg:col-span-2">
          <p class="text-lg text-ink-700">{sol.short}</p>

          {depth?.intro?.map(p => <p class="mt-5 text-ink-700">{p}</p>)}

          {depth && depth.whoFor.length > 0 && (
            <>
              <h2 class="h3 mt-12">Who this fits</h2>
              <ul class="mt-6 space-y-3">
                {depth.whoFor.map(w => (
                  <li class="flex gap-3">
                    <span class="mt-1 inline-flex h-6 w-6 flex-none items-center justify-center rounded-full bg-brand-100 text-brand-700 text-xs font-bold">&rarr;</span>
                    <span class="text-ink-700">{w}</span>
                  </li>
                ))}
              </ul>
            </>
          )}

          <h2 class="h3 mt-12">Core features</h2>
          <ul class="mt-6 grid gap-3 sm:grid-cols-2">
            {sol.features.map(f => (
              <li class="flex gap-3">
                <span class="mt-1 inline-flex h-6 w-6 flex-none items-center justify-center rounded-full bg-brand-100 text-brand-700 text-xs font-bold">&#10003;</span>
                <span class="text-ink-700">{f}</span>
              </li>
            ))}
          </ul>

          {depth && depth.capabilities.length > 0 && (
            <>
              <h2 class="h3 mt-14">How Odoo covers {sol.title.toLowerCase()}</h2>
              <div class="mt-6 space-y-8">
                {depth.capabilities.map(c => (
                  <div>
                    <h3 class="font-semibold text-ink-900">{c.title}</h3>
                    <p class="mt-2 text-ink-700">{c.body}</p>
                  </div>
                ))}
              </div>
            </>
          )}

          {depth && depth.setup.length > 0 && (
            <>
              <h2 class="h3 mt-14">How the rollout runs</h2>
              <div class="mt-6 space-y-8">
                {depth.setup.map(c => (
                  <div>
                    <h3 class="font-semibold text-ink-900">{c.title}</h3>
                    <p class="mt-2 text-ink-700">{c.body}</p>
                  </div>
                ))}
              </div>
            </>
          )}

          {depth && depth.pitfalls.length > 0 && (
            <>
              <h2 class="h3 mt-14">Where these projects go wrong</h2>
              <div class="mt-6 space-y-6">
                {depth.pitfalls.map(c => (
                  <div class="rounded-2xl border border-ink-200 p-6">
                    <h3 class="font-semibold text-ink-900">{c.title}</h3>
                    <p class="mt-2 text-ink-700">{c.body}</p>
                  </div>
                ))}
              </div>
            </>
          )}

          {depth && depth.worksWith.length > 0 && (
            <>
              <h2 class="h3 mt-14">What it works with</h2>
              <ul class="mt-6 grid gap-3 sm:grid-cols-2">
                {depth.worksWith.map(w => (
                  <li class="flex gap-3">
                    <span class="mt-1 inline-flex h-6 w-6 flex-none items-center justify-center rounded-full bg-ink-100 text-ink-700 text-xs font-bold">+</span>
                    <span class="text-ink-700">{w}</span>
                  </li>
                ))}
              </ul>
            </>
          )}

          {regional.length > 0 && (
            <>
              <h2 class="h3 mt-14">Country considerations</h2>
              <div class="mt-6 space-y-5">
                {regional.map(r => (
                  <div>
                    <h3 class="font-semibold text-ink-900">
                      <a class="hover:text-brand-600" href={`/countries/${r.country}/`}>{countryBySlug.get(r.country).title}</a>
                    </h3>
                    <p class="mt-2 text-ink-700">{r.note}</p>
                  </div>
                ))}
              </div>
            </>
          )}

          {depth && depth.faqs.length > 0 && (
            <>
              <h2 class="h3 mt-14">Questions we get asked</h2>
              <div class="mt-6 space-y-6">
                {depth.faqs.map(f => (
                  <div class="rounded-2xl bg-ink-50 p-6">
                    <h3 class="font-semibold text-ink-900">{f.q}</h3>
                    <p class="mt-2 text-ink-700">{f.a}</p>
                  </div>
                ))}
              </div>
            </>
          )}

          {!depth && (
            <>
              <h2 class="h3 mt-14">Why Way4Tech for {sol.title.toLowerCase()}</h2>
              <div class="mt-6 grid gap-4 sm:grid-cols-2">
                {[
                  {t:'Deep domain expertise', d:`We've deployed Odoo for ${sol.title.toLowerCase()} across multiple countries and scales.`},
                  {t:'Localization built in', d:'Tax, e-invoicing, labor law - compliant from day one.'},
                  {t:'Community-friendly', d:'Runs on Odoo Community where possible. Enterprise only if it pays off.'},
                  {t:'Long-term partnership', d:'We stay involved. 5+ year client relationships are our norm.'},
                ].map(x => (
                  <div class="card">
                    <h3 class="font-semibold">{x.t}</h3>
                    <p class="mt-2 text-sm text-ink-600">{x.d}</p>
                  </div>
                ))}
              </div>
            </>
          )}
        </div>

        <aside class="lg:col-span-1">
          <div class="sticky top-24 space-y-6">
            <div class="rounded-2xl bg-odoo-gradient p-6 text-white">
              <h3 class="text-lg font-semibold">Scope a project</h3>
              <p class="mt-2 text-sm text-brand-100">Free 30-min consultation. Fixed-price or T&M.</p>
              <a href={`/contact/?service=${encodeURIComponent('Odoo for ' + sol.title)}&source=solutions/${sol.slug}`} class="btn-primary w-full mt-5 bg-white !text-brand-700 hover:bg-brand-50">Get a quote</a>
            </div>
            <div class="rounded-2xl bg-ink-50 p-6">
              <h3 class="text-sm font-semibold">Other industries</h3>
              <ul class="mt-4 space-y-2">
                {related.map(r => (
                  <li><a class="text-sm text-ink-700 hover:text-brand-600" href={`/solutions/${r.slug}/`}>{r.icon} {r.title}</a></li>
                ))}
              </ul>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Base>
