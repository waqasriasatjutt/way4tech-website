---
import Base from '~/layouts/Base.astro';
import { breadcrumb } from '~/utils/schema';
import { SITE } from '~/data/site';
import { SUITES, SUITE_GROUPS } from '~/data/suites';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Way4Tech industry suites',
    itemListElement: SUITES.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: s.name, url: `${SITE.url}/suites/${s.slug}/` })),
  },
];
---
<Base
  title="Industry Suites for Odoo 19 and 20"
  description="Way4Tech suites for Odoo 19 and 20: construction, real estate, restaurant, HR and payroll, hospital, distribution, facility management, salon, gym, school, hotel and more, with live demos and free guides."
  structuredData={[schema, breadcrumb([{ name: 'Suites', path: '/suites/' }])].flat()}
>
  <section class="bg-ink-900 text-white">
    <div class="container-site py-16 sm:py-24">
      <div class="max-w-3xl">
        <div class="eyebrow text-brand-300">Industry suites</div>
        <h1 class="h1 mt-4">Odoo suites by industry and by job</h1>
        <p class="lede mt-6 text-ink-300">Each suite is a set of our store modules that work together, most with a live demo you can open, and free guides. For a hosted system we run for you, see <a href="/software/" class="underline hover:text-white">Software</a>.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-site">
      {SUITE_GROUPS.map(g => (
      <h2 class="h3 mt-12 first:mt-0">{g}</h2>
      <div class="mt-6 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {SUITES.filter(s => s.group === g).map(s => (
          <a href={`/suites/${s.slug}/`} class="card group flex flex-col">
            <div class="flex items-start justify-between gap-3">
              <h3 class="text-lg font-semibold">{s.name}</h3>
              {s.badge && <span class="badge flex-none">{s.badge}</span>}
            </div>
            <p class="mt-2 flex-1 text-sm text-ink-600">{s.lede}</p>
            <span class="mt-4 text-sm font-semibold text-brand-600 group-hover:text-brand-700">See the suite &rarr;</span>
          </a>
        ))}
      </div>
      ))}
      <p class="mt-10 text-sm text-ink-500">Looking for a single module? <a href="/products/" class="font-semibold text-brand-600 hover:text-brand-700">Browse every store module</a>.</p>
    </div>
  </section>
</Base>
