---
import Base from '~/layouts/Base.astro';
import { SITE } from '~/data/site';
import { WINDOWS_APPS, WINDOWS_APP_RELEASES, storeUrlOf } from '~/data/windows-apps';

const cards = WINDOWS_APPS.map(app => ({ app, rel: WINDOWS_APP_RELEASES[app.slug] }));

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Windows apps for Odoo',
    itemListElement: cards.map(({ app }, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: new URL(`/${app.slug}/`, SITE.url).toString(),
      name: app.name,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', SITE.url).toString() },
      { '@type': 'ListItem', position: 2, name: 'Windows apps for Odoo', item: new URL('/windows-apps/', SITE.url).toString() },
    ],
  },
];
---
<Base
  title="Windows Apps for Odoo: Free Desktop Agents"
  description="Free Windows apps that connect Odoo to attendance devices, POS hardware, truck scales, scanners, Tally, phones and webcams, plus a screen recorder."
  structuredData={schema}
>
  <section class="bg-odoo-gradient text-white">
    <div class="container-site py-16 sm:py-20">
      <nav class="text-sm text-brand-200" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white">Home</a> / <span class="text-white">Windows apps</span>
      </nav>
      <div class="mt-6 max-w-3xl">
        <h1 class="h1">Windows apps for Odoo</h1>
        <p class="lede mt-6 text-brand-100">
          Some jobs need a PC in the office: reading a fingerprint terminal on the LAN, driving a receipt printer,
          listening to a truck scale, scanning paper, talking to Tally. These small Windows programs do that part
          and hand the result to Odoo, where every setting and report lives.
        </p>
        <p class="mt-4 text-brand-100">
          Each app is a free download. The matching Odoo module is on the Odoo Apps Store. Once installed, the apps
          update themselves and accept only releases signed by Way4Tech.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-site">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {cards.map(({ app, rel }) => (
          <div class="card group flex flex-col !p-0 overflow-hidden">
            <a href={`/${app.slug}/`} class="block border-b border-ink-100 bg-ink-50">
              <img src={rel.shots[0].src} width={rel.shots[0].w} height={rel.shots[0].h} loading="lazy" decoding="async"
                   alt={app.captions[rel.shots[0].key] || app.name}
                   class="aspect-[16/10] w-full object-cover object-top" />
            </a>
            <div class="flex flex-1 flex-col p-5">
              <span class="text-xs font-semibold uppercase tracking-wider text-ink-500">{app.category}</span>
              <h2 class="mt-2 text-lg font-semibold"><a href={`/${app.slug}/`} class="hover:text-brand-700">{app.name}</a></h2>
              <p class="mt-2 text-sm text-ink-600">{app.tagline}</p>
              <p class="mt-3 text-xs text-ink-500">Version {rel.version} · {app.module ? 'Works with Odoo 19' : 'Standalone, no Odoo needed'}</p>
              <div class="mt-auto flex flex-wrap gap-3 pt-5 text-sm">
                <a href={`/${app.slug}/`} class="font-semibold text-brand-600 hover:text-brand-700">Details and download →</a>
                {app.module && (
                  <a href={storeUrlOf(app.module)} target="_blank" rel="noopener" class="text-ink-600 hover:text-brand-700">Odoo module</a>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-14 rounded-2xl border border-amber-200 bg-amber-50 p-6 text-amber-900">
        <h2 class="text-lg font-semibold">About the Windows SmartScreen notice</h2>
        <p class="mt-2">
          Windows may show a SmartScreen notice until our code-signing certificate is active: click More info, then Run anyway.
          Each download page lists the installer's SHA-256 so you can check the file before running it.
        </p>
      </div>
    </div>
  </section>

  <section class="section bg-ink-50 border-t border-ink-100">
    <div class="container-site text-center">
      <h2 class="h2">Need a device or program connected to Odoo?</h2>
      <p class="lede mt-4 max-w-2xl mx-auto">Every app here started with a client who had hardware or software Odoo could not reach. If yours is not on the list, tell us what it is.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/contact/?source=windows-apps" class="btn-primary">Contact us</a>
        <a href="/products/" class="btn-secondary">Our Odoo modules</a>
      </div>
    </div>
  </section>
</Base>
